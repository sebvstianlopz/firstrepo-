---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/reenie-beanie/latin-400.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BagDrawer from '../components/BagDrawer.astro';
import ogDefault from '../assets/campaign/hero.jpg';
import { site, url } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean;
}
const { title, description, image = ogDefault, noindex = false } = Astro.props;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const fullTitle = title === site.name ? site.name : `${title} · ${site.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BagDrawer />
    <script>
      import '../scripts/reveal';
      import '../scripts/saved';
      import { applyCity } from '../scripts/city';
      applyCity();
    </script>
  </body>
</html>
