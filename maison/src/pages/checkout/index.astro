---
import Base from '../../layouts/Base.astro';
import CitySelect from '../../components/CitySelect.astro';
import { url } from '../../config/site';
---
<Base title="Checkout" description="Review your bag and arrange delivery." noindex>
  <section class="wrap pt-10 sm:pt-16">
    <h1 class="head">Checkout</h1>
  </section>

  <div class="wrap pt-10" data-checkout-empty hidden>
    <p class="statement">Your bag is empty.</p>
    <a href={url('collection/')} class="btn mt-8">Discover the collection</a>
  </div>

  <div class="checkout wrap pt-10" data-checkout>
    <form class="grid gap-10 content-start" data-checkout-form novalidate>
      <fieldset class="grid gap-4">
        <legend class="text-[20px] font-medium mb-4">Contact</legend>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="input" />
        </div>
        <div class="field">
          <label for="phone">Phone, for the courier</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" class="input" />
        </div>
      </fieldset>

      <fieldset class="grid gap-4">
        <legend class="text-[20px] font-medium mb-4">Delivery</legend>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="field">
            <label for="first">First name</label>
            <input id="first" name="first" required autocomplete="given-name" class="input" />
          </div>
          <div class="field">
            <label for="last">Last name</label>
            <input id="last" name="last" required autocomplete="family-name" class="input" />
          </div>
        </div>
        <div class="field">
          <label for="address">Address</label>
          <input id="address" name="address" required autocomplete="street-address" class="input" />
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <CitySelect id="city-checkout" />
          <div class="field">
            <label for="postcode">Postcode</label>
            <input id="postcode" name="postcode" autocomplete="postal-code" class="input" />
          </div>
        </div>
      </fieldset>

      <div class="notice">
        <p class="font-medium">Payment is switched off in this design study.</p>
        <p class="small mt-1">No card details are asked for or stored. Placing the order shows the confirmation a client would see.</p>
      </div>

      <p class="small text-[#8a2b1d]" data-form-error role="alert" hidden>Please fill in your email, name and address.</p>
      <button class="btn w-full sm:w-fit">Place order (demo)</button>
    </form>

    <aside class="summary" aria-labelledby="summary-title">
      <h2 id="summary-title" class="text-[20px] font-medium">Your order</h2>
      <ul class="grid gap-4 mt-6" data-summary-list></ul>
      <dl class="totals mt-8">
        <div><dt>Subtotal</dt><dd data-subtotal></dd></div>
        <div><dt>Delivery to <span data-city-name>New York</span></dt><dd>Complimentary</dd></div>
        <div class="total"><dt>Total</dt><dd data-total></dd></div>
      </dl>
      <p class="small muted mt-4">Arriving <span data-city-days>in 2 days</span>, signed for on delivery.</p>
    </aside>
  </div>
</Base>

<style>
  .checkout {
    display: grid;
    gap: 56px;
  }
  @media (min-width: 900px) {
    .checkout {
      grid-template-columns: 7fr 5fr;
      gap: clamp(48px, 6vw, 120px);
      align-items: start;
    }
    .summary {
      position: sticky;
      top: 88px;
    }
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .notice {
    padding: 20px;
    background: var(--color-surface);
  }
  .summary {
    padding: 28px;
    background: var(--color-surface);
  }
  .summary :global(li) {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 14px;
    align-items: start;
  }
  .summary :global(img) {
    width: 72px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .totals {
    display: grid;
    gap: 10px;
  }
  .totals div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .totals .total {
    margin-top: 8px;
    font-size: 20px;
    font-weight: 500;
  }
</style>

<script>
  import { readBag, bagTotal, clearBag } from '../../scripts/bag';
  import { getCity, price } from '../../scripts/city';
  import { url } from '../../config/site';

  const list = document.querySelector<HTMLUListElement>('[data-summary-list]')!;

  function render() {
    const items = readBag();
    document.querySelector<HTMLElement>('[data-checkout]')!.hidden = items.length === 0;
    document.querySelector<HTMLElement>('[data-checkout-empty]')!.hidden = items.length > 0;
    list.replaceChildren(
      ...items.map((item) => {
        const li = document.createElement('li');
        const img = Object.assign(new Image(72, 90), { src: item.image, alt: '' });
        const text = document.createElement('div');
        text.innerHTML = '<p class="font-medium leading-snug"></p><p class="small muted"></p>';
        text.children[0].textContent = item.name;
        text.children[1].textContent = [item.color, item.size && `Size ${item.size}`, `Qty ${item.qty}`].filter(Boolean).join(' · ');
        const cost = document.createElement('span');
        cost.className = 'tabular-nums';
        cost.textContent = price(item.price * item.qty);
        li.append(img, text, cost);
        return li;
      }),
    );
    const total = price(bagTotal(items));
    document.querySelector('[data-subtotal]')!.textContent = total;
    document.querySelector('[data-total]')!.textContent = total;
  }

  const form = document.querySelector<HTMLFormElement>('[data-checkout-form]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const error = form.querySelector<HTMLElement>('[data-form-error]')!;
    if (!form.checkValidity()) {
      error.hidden = false;
      form.querySelector<HTMLInputElement>(':invalid')?.focus();
      return;
    }
    error.hidden = true;
    const data = new FormData(form);
    const items = readBag();
    const city = getCity();
    const order = {
      number: 'LV-' + Date.now().toString(36).toUpperCase().slice(-6),
      name: String(data.get('first')),
      email: String(data.get('email')),
      city: city.name,
      days: city.days,
      total: price(bagTotal(items)),
      items: items.map((i) => ({ name: i.name, detail: [i.color, i.size && `Size ${i.size}`, `Qty ${i.qty}`].filter(Boolean).join(' · '), image: i.image, cost: price(i.price * i.qty) })),
    };
    try {
      sessionStorage.setItem('maison-order', JSON.stringify(order));
    } catch {
      /* the confirmation falls back to a general message */
    }
    clearBag();
    location.href = url('checkout/confirmation/');
  });

  form.addEventListener('input', () => {
    form.querySelector<HTMLElement>('[data-form-error]')!.hidden = true;
  });

  document.addEventListener('bag:change', render);
  document.addEventListener('city:change', render);
  render();
</script>
