---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Hero from '../components/home/Hero.astro';
import Bento from '../components/home/Bento.astro';
import Editorial from '../components/home/Editorial.astro';
import NewArrivals from '../components/home/NewArrivals.astro';
import { site } from '../config/site';
import { getPieces } from '../utils/pieces';

const pieces = await getPieces();
const featured = pieces.filter((p) => p.data.featured);
// Lead with a garment, then a bag and a menswear piece beside it.
const bento = [featured[0], featured.find((p) => p.data.category === 'leather-goods'), featured.find((p) => p.data.category === 'men')].filter(
  (p): p is (typeof pieces)[number] => Boolean(p),
);
---
<Base title={site.name} description={`The ${site.season} collection: ready-to-wear and leather goods, delivered complimentary worldwide.`}>
  <PageTitle text={site.name} />
  <Hero pieces={pieces} />
  <Bento pieces={bento} />
  <Editorial />
  <NewArrivals pieces={pieces.filter((p) => p.data.isNew)} />
</Base>
