---
import PageTitle from './PageTitle.astro';
import { categories, site, url } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="grid gap-6 content-start">
      <a class="footer-email link" href={`mailto:${site.advisorEmail}`}>{site.advisorEmail}</a>
      <div class="flex gap-5">
        <a href={site.social.x} class="social" aria-label="X">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="2" /></svg>
        </a>
        <a href={site.social.instagram} class="social" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" /></svg>
        </a>
        <a href={site.social.youtube} class="social" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" fill="currentColor" /><path d="M10 9.2v5.6l4.8-2.8z" style="fill: var(--color-bg)" /></svg>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <p class="label font-bold">Address</p>
      <p class="label muted">{site.address.map((l) => <>{l}<br /></>)}</p>
    </div>

    <div class="footer-col">
      <p class="label font-bold">Shop</p>
      <nav aria-label="Footer" class="grid gap-1 label">
        {Object.entries(categories).map(([id, label]) => (
          <a class="link w-fit" href={url(`collection/?c=${id}`)}>{label}</a>
        ))}
      </nav>
    </div>

    <form class="footer-col" data-newsletter>
      <label for="newsletter" class="label font-bold">News</label>
      <div class="flex">
        <input id="newsletter" type="email" required autocomplete="email" placeholder="Email address" class="input" />
        <button class="btn shrink-0 px-5">Join</button>
      </div>
      <p class="label" data-thanks hidden role="status">Thank you. See you next season.</p>
    </form>
  </div>

  <div class="wrap legal label muted">
    <p>{site.disclaimer}</p>
    <p>© {year} Concept storefront</p>
  </div>

  <div class="footer-name">
    <PageTitle text={site.name} as="p" ghost />
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    padding-top: 64px;
    border-top: 1px solid var(--color-line);
    overflow: hidden;
  }
  .footer-grid {
    display: grid;
    gap: 40px 32px;
  }
  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 6fr 2fr 2fr 3fr;
    }
  }
  .footer-email {
    font-size: clamp(26px, 3vw, 44px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .footer-col {
    display: grid;
    align-content: start;
    gap: 12px;
  }
  .social {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: -7px;
    transition: transform 160ms var(--ease-out);
  }
  .social:active {
    transform: scale(0.9);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 32px;
    padding-top: 72px;
    text-transform: none;
  }
  /* The name, cropped by the bottom edge. */
  .footer-name {
    margin-top: 24px;
    margin-bottom: -0.13em;
    line-height: 0;
  }
  .footer-name :global(.fit-text) {
    transform: translateY(14%);
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) =>
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.querySelector<HTMLElement>('[data-thanks]')!.hidden = false;
      form.reset();
    }),
  );
</script>
