---
import PieceCard from '../PieceCard.astro';
import { url } from '../../config/site';
import type { Piece } from '../../utils/pieces';

interface Props {
  pieces: Piece[];
}
const { pieces } = Astro.props;
---
<section class="wrap arrivals" aria-labelledby="arrivals-title">
  <div class="flex items-baseline justify-between gap-4 mb-8">
    <h2 id="arrivals-title" class="title">New arrivals</h2>
    <a href={url('collection/')} class="label link">View all</a>
  </div>
  <div class="grid-pieces grid-3" data-reveal>
    {pieces.map((p) => <PieceCard piece={p} />)}
  </div>
</section>

<style>
  .arrivals {
    margin-top: var(--section-gap);
  }
</style>
