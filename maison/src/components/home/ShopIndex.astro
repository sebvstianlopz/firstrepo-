---
// One giant word, then a stack of filled bars: every piece by category,
// plus the house's services. Each bar opens in place.
import Price from '../Price.astro';
import { categories, cities, site, url, type Category } from '../../config/site';
import type { Piece } from '../../utils/pieces';

interface Props {
  pieces: Piece[];
}
const { pieces } = Astro.props;
const groups = (Object.keys(categories) as Category[]).map((id) => ({
  id,
  label: categories[id],
  items: pieces.filter((p) => p.data.category === id),
}));
const fastest = Math.min(...cities.map((c) => c.days));
---
<section class="index wrap" aria-labelledby="index-title">
  <div class="index-col">
    <h2 id="index-title" class="index-word">Shop</h2>

    <div class="grid gap-[6px] mt-5">
      {groups.map((g, i) => (
        <details class="bar" open={i === 0}>
          <summary>
            <span>{g.label} <span class="muted font-normal">{g.items.length}</span></span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <ul>
            {g.items.map((p) => (
              <li>
                <a class="link" href={url(`collection/${p.id}/`)}>{p.data.name}</a>
                <Price usd={p.data.price} />
              </li>
            ))}
            <li><a class="link font-medium" href={url(`collection/?c=${g.id}`)}>See all {g.label.toLowerCase()}</a></li>
          </ul>
        </details>
      ))}
      <details class="bar">
        <summary>
          <span>Delivery and returns</span>
          <span class="plus" aria-hidden="true"></span>
        </summary>
        <div class="bar-text">
          <p>Delivery is complimentary to every city we serve, from {fastest} business day in Paris to four in Sydney. Choose your city at the top of the page to see yours.</p>
          <p>Returns are free within {site.returnsDays} days, collected from your door.</p>
        </div>
      </details>
      <details class="bar">
        <summary>
          <span>Client advisors</span>
          <span class="plus" aria-hidden="true"></span>
        </summary>
        <div class="bar-text">
          <p>An advisor can help with sizing, set a piece aside, or arrange a private appointment in the city nearest you.</p>
          <p><a class="link font-medium" href={`mailto:${site.advisorEmail}`}>Write to an advisor</a></p>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .index {
    margin-top: var(--section-gap);
    display: grid;
    justify-items: center;
  }
  .index-col {
    width: min(640px, 100%);
    container-type: inline-size;
  }
  .index-word {
    font-size: 41cqw;
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.06em;
    text-transform: uppercase;
    margin-left: -0.04em;
  }
  .bar {
    background: var(--color-surface);
  }
  .bar summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 0 18px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease;
  }
  .bar summary::-webkit-details-marker {
    display: none;
  }
  .bar summary:hover {
    background: var(--color-surface-2);
  }
  .plus {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease-out);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  .bar[open] .plus::after {
    transform: rotate(0deg);
  }
  .bar ul,
  .bar-text {
    display: grid;
    gap: 14px;
    padding: 6px 20px 22px;
  }
  .bar li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .bar-text {
    max-width: 52ch;
  }
</style>
