---
// The house's origin, told through four objects that pass a pinned title.
import { Image } from 'astro:assets';
import trunk from '../../assets/house/trunk.jpg';
import lock from '../../assets/house/lock.jpg';
import canvas from '../../assets/house/canvas.jpg';
import thread from '../../assets/house/thread.jpg';
import { url } from '../../config/site';

const objects = [
  {
    img: trunk,
    name: 'The trunk',
    note: 'Paris, 1854',
    text: 'The house began by making flat-topped trunks that could be stacked in the hold of a ship. Every bag here still starts from that idea.',
  },
  {
    img: lock,
    name: 'The lock',
    note: 'Solid brass',
    text: 'Locks, corners and buckles are cut from brass, which darkens slowly to the colour of the hand that carries it.',
  },
  {
    img: canvas,
    name: 'The canvas',
    note: 'Coated, light, waterproof',
    text: 'A material for bags that are meant to be used and not kept: it wipes clean after the rain and the station platform.',
  },
  {
    img: thread,
    name: 'The cloth',
    note: 'Ready-to-wear',
    text: 'Coats in double-face wool and cashmere, finished by hand so they need no lining, and travel folded in a weekender.',
  },
];
---
<section class="craft wrap" aria-labelledby="craft-title">
  <div class="craft-title">
    <h2 id="craft-title" class="craft-heading">Made to travel</h2>
    <a href={url('collection/?c=leather-goods')} class="btn btn-quiet w-fit mt-10">Leather goods</a>
  </div>

  <ol class="craft-objects" aria-label="What the pieces are made from">
    {objects.map((o, i) => (
      <li class:list={['craft-object', i % 2 ? 'is-right' : 'is-left']} data-reveal>
        <div class="frame aspect-[4/5]">
          <Image src={o.img} alt={`Drawing: ${o.name.toLowerCase()}`} widths={[500, 900]} sizes="(min-width: 900px) 28vw, 72vw" />
        </div>
        <p class="mt-4 text-[16px] font-medium">{o.name}</p>
        <p class="small muted">{o.note}</p>
        <p class="mt-2 max-w-[300px]">{o.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .craft {
    margin-top: var(--section-gap);
    display: grid;
    gap: 48px;
  }
  .craft-heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(64px, 8.4vw, 150px);
    line-height: 0.88;
    letter-spacing: -0.03em;
    max-width: 7.5ch;
  }
  .craft-objects {
    display: grid;
    gap: 72px;
    list-style: none;
    padding: 0;
  }
  .craft-object .frame {
    width: 72%;
  }
  .craft-object.is-right .frame {
    margin-left: auto;
  }
  .craft-object.is-right > p {
    margin-left: 28%;
  }
  @media (min-width: 900px) {
    .craft {
      grid-template-columns: 5fr 7fr;
      gap: 0;
    }
    .craft-title {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .craft-objects {
      gap: 10svh;
      padding-block: 12svh 16svh;
    }
    .craft-object {
      width: 26vw;
    }
    .craft-object.is-right {
      justify-self: end;
    }
    .craft-object .frame {
      width: 100%;
    }
    .craft-object.is-right > p {
      margin-left: 0;
    }
  }
</style>
