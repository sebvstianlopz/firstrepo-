---
import { url } from '../config/site';
---
<dialog class="drawer" data-bag aria-labelledby="bag-title">
  <div class="drawer-panel">
    <div class="drawer-head">
      <h2 id="bag-title" class="label font-bold">Bag <span class="muted" data-bag-lines></span></h2>
      <button type="button" class="label link" data-close>Close</button>
    </div>

    <div class="px-6 pt-10" data-bag-empty>
      <p class="title">Your bag is empty.</p>
      <a href={url('collection/')} class="btn mt-8">Shop the collection</a>
    </div>

    <ul class="drawer-list" data-bag-list></ul>

    <div class="drawer-foot" data-bag-foot>
      <div class="flex justify-between items-baseline">
        <span class="label font-bold">Subtotal</span>
        <span class="text-[20px] font-bold tabular-nums" data-bag-total></span>
      </div>
      <p class="label muted normal-case mt-2">
        Complimentary delivery to <span data-city-name>New York</span>, arriving <span data-city-days>in 2 days</span>.
        Returns within 30 days.
      </p>
      <a href={url('checkout/')} class="btn w-full mt-5">Checkout</a>
    </div>
  </div>
</dialog>

<template data-bag-line>
  <li class="line">
    <a class="thumb" data-thumb tabindex="-1" aria-hidden="true"></a>
    <div class="grid content-start gap-1 min-w-0">
      <a class="label font-semibold link line-name" data-name></a>
      <span class="label muted" data-meta></span>
      <div class="line-foot mt-3">
        <div class="qty">
          <button type="button" data-dec aria-label="One fewer">−</button>
          <span data-qty></span>
          <button type="button" data-inc aria-label="One more">+</button>
        </div>
        <span data-price class="font-bold tabular-nums whitespace-nowrap"></span>
      </div>
      <button type="button" class="label muted link w-fit mt-1" data-remove>Remove</button>
    </div>
  </li>
</template>

<style>
  /* Opens with the iOS drawer curve; closes faster than it opens. */
  .drawer {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    background: transparent;
    overflow: hidden;
    transition:
      display 250ms allow-discrete,
      overlay 250ms allow-discrete;
  }
  .drawer::backdrop {
    background: rgb(0 0 0 / 0.3);
    transition:
      opacity 300ms ease,
      display 250ms allow-discrete,
      overlay 250ms allow-discrete;
  }
  .drawer:not([open])::backdrop {
    opacity: 0;
    transition-duration: 200ms;
  }
  .drawer-panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(440px, 100%);
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    color: var(--color-ink);
    transform: none;
    transition: transform 400ms var(--ease-drawer);
  }
  .drawer:not([open]) .drawer-panel {
    transform: translateX(100%);
    transition: transform 250ms var(--ease-out);
  }
  @starting-style {
    .drawer[open] .drawer-panel {
      transform: translateX(100%);
    }
    .drawer[open]::backdrop {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .drawer-panel,
    .drawer:not([open]) .drawer-panel {
      transform: none;
      transition: opacity 200ms ease;
    }
    .drawer:not([open]) .drawer-panel {
      opacity: 0;
    }
    @starting-style {
      .drawer[open] .drawer-panel {
        transform: none;
        opacity: 0;
      }
    }
  }
  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: calc(64px + env(safe-area-inset-top, 0px));
    padding: env(safe-area-inset-top, 0px) 24px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .drawer-list {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 24px;
  }
  .drawer-foot :global([data-bag-total]) {
    overflow-wrap: anywhere;
    text-align: right;
  }
  .drawer-foot {
    padding: 20px 24px calc(20px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
  }
  .drawer :global(.line) {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-line);
  }
  .drawer :global(.thumb) {
    display: block;
    aspect-ratio: 1;
    background: var(--color-surface);
  }
  .drawer :global(.thumb img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .drawer :global(.line-name) {
    overflow-wrap: anywhere;
  }
  .drawer :global(.line-foot) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }
  .drawer :global(.qty) {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    border: 1px solid var(--color-line);
  }
  .drawer :global(.qty button) {
    width: 34px;
    height: 34px;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      transform 160ms var(--ease-out);
  }
  .drawer :global(.qty button:active) {
    transform: scale(0.9);
  }
  .drawer :global(.qty span) {
    min-width: 24px;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  @media (hover: hover) and (pointer: fine) {
    .drawer :global(.qty button:hover) {
      background: var(--color-surface);
    }
  }
</style>

<script>
  import { readBag, setQty, bagCount, bagTotal } from '../scripts/bag';
  import { price } from '../scripts/city';
  import { url } from '../config/site';

  const dialog = document.querySelector<HTMLDialogElement>('[data-bag]')!;
  const list = dialog.querySelector<HTMLUListElement>('[data-bag-list]')!;
  const tpl = document.querySelector<HTMLTemplateElement>('[data-bag-line]')!;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let lastCount = bagCount();

  function render() {
    const items = readBag();
    const count = bagCount(items);
    document.querySelectorAll<HTMLElement>('[data-bag-count]').forEach((el) => {
      el.textContent = String(count);
      el.hidden = count === 0;
      // A small bump only when something was added.
      if (count > lastCount && !reduceMotion.matches) {
        el.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.3)' }, { transform: 'scale(1)' }], {
          duration: 260,
          easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
        });
      }
    });
    lastCount = count;
    dialog.querySelector('[data-bag-lines]')!.textContent = count ? `(${count})` : '';
    dialog.querySelector<HTMLElement>('[data-bag-empty]')!.hidden = items.length > 0;
    dialog.querySelector<HTMLElement>('[data-bag-foot]')!.hidden = items.length === 0;
    dialog.querySelector('[data-bag-total]')!.textContent = price(bagTotal(items));
    list.replaceChildren(
      ...items.map((item, i) => {
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        const href = url(`collection/${item.slug}/`);
        const thumb = li.querySelector<HTMLAnchorElement>('[data-thumb]')!;
        thumb.href = href;
        const img = Object.assign(new Image(88, 88), { src: item.image, alt: '' });
        // A missing picture leaves the grey well rather than a broken-image icon.
        img.onerror = () => img.remove();
        thumb.append(img);
        const name = li.querySelector<HTMLAnchorElement>('[data-name]')!;
        name.textContent = item.name;
        name.href = href;
        li.querySelector('[data-meta]')!.textContent = [`[${item.color}]`, item.size && `Size ${item.size}`].filter(Boolean).join(' · ');
        li.querySelector('[data-qty]')!.textContent = String(item.qty);
        li.querySelector('[data-price]')!.textContent = price(item.price * item.qty);
        li.querySelector('[data-dec]')!.addEventListener('click', () => setQty(i, item.qty - 1));
        li.querySelector('[data-inc]')!.addEventListener('click', () => setQty(i, item.qty + 1));
        li.querySelector('[data-remove]')!.addEventListener('click', () => setQty(i, 0));
        return li;
      }),
    );
  }

  const openBag = () => !dialog.open && dialog.showModal();
  const close = () => dialog.close();

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-open-bag]')) openBag();
  });
  document.addEventListener('bag:open', openBag);
  dialog.querySelector('[data-close]')!.addEventListener('click', close);
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  document.addEventListener('bag:change', render);
  document.addEventListener('city:change', render);
  addEventListener('storage', render);
  render();
</script>
