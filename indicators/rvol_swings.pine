//@version=6
indicator("RVOL Candles + Swing Highs & Lows", shorttitle = "RVOL + Swings", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ═════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════

// ── RVOL candle highlighting ──
grpRvol = "RVOL Candles"
showRvol       = input.bool(true, "Enable RVOL candle highlighting", group = grpRvol)
mode           = input.string("Simple", "Mode", options = ["Simple", "Time of Day"], group = grpRvol,
     tooltip = "Simple: current volume vs the average of the last N bars.\nTime of Day: current volume vs the average volume at the same time of day over the last N sessions (intraday charts only).")
length         = input.int(20, "Lookback (bars / sessions)", minval = 1, group = grpRvol)
avgType        = input.string("SMA", "Average Type", options = ["SMA", "EMA", "Median"], group = grpRvol,
     tooltip = "In Time of Day mode, SMA and EMA both use a simple mean.")
excludeCurrent = input.bool(true, "Exclude current bar from average", group = grpRvol,
     tooltip = "Simple mode only. Compares the current bar to the average of the previous N bars.")
highLvl        = input.float(2.0, "Strong RVOL",  minval = 0, step = 0.1, group = grpRvol,
     tooltip = "Candles at or above this RVOL are highlighted on the chart.")
extremeLvl     = input.float(3.0, "Extreme RVOL", minval = 0, step = 0.1, group = grpRvol,
     tooltip = "Candles at or above this RVOL are highlighted in full color. Strong candles below this level use a lighter shade.")
strongShade    = input.int(40, "Strong Candle Transparency", minval = 0, maxval = 90, group = grpRvol,
     tooltip = "How light the Strong (but not Extreme) candles are. 0 = same as Extreme, higher = lighter.")
dimOthers      = input.bool(false, "Dim all other candles", group = grpRvol,
     tooltip = "Grays out every candle that isn't highlighted so the strong-volume candles stand out.")
showTable      = input.bool(false, "Show RVOL info table", group = grpRvol)

grpSplit = "RVOL Buy / Sell Split"
splitMethod = input.string("Intrabar", "Method", options = ["Intrabar", "Candle Range"], group = grpSplit,
     tooltip = "Intrabar: looks inside each candle using a lower timeframe. Volume on up-ticks counts as buying, volume on down-ticks counts as selling. Most accurate.\nCandle Range: estimates from where the candle closed inside its high-low range. Closing near the high = mostly buying, near the low = mostly selling.\nIf intrabar data isn't available for older bars, those bars use Candle Range automatically.")
customLtf   = input.timeframe("", "Intrabar Timeframe (blank = auto)", group = grpSplit,
     tooltip = "Auto: 1 second on seconds charts, 1 minute on intraday charts, 5 minutes on daily charts, 60 minutes on weekly and above.")
dominance   = input.float(55.0, "Min Dominance % to Highlight", minval = 50, maxval = 100, step = 1, group = grpSplit,
     tooltip = "A strong-volume candle is only highlighted if buyers (or sellers) made up at least this % of its volume.")

// ── Swing highs & lows ──
grpDet = "Swings"
showSwings = input.bool(true, "Enable swing highs & lows", group = grpDet)
leftBars   = input.int(5, "Left Bars", minval = 1, group = grpDet,
     tooltip = "How many candles to the LEFT of a swing high must have lower highs (or higher lows for a swing low).")
rightBars  = input.int(5, "Right Bars", minval = 1, group = grpDet,
     tooltip = "How many candles to the RIGHT must have lower highs (or higher lows). A swing is only confirmed after this many candles close, so labels appear with this delay.")
swingSrc   = input.string("Wicks", "Swing Source", options = ["Wicks", "Bodies"], group = grpDet,
     tooltip = "Wicks: uses the candle highs and lows.\nBodies: uses the top and bottom of the candle bodies, ignoring wicks.")

grpLbl = "Swing Labels"
showLabels  = input.bool(true, "Show labels", group = grpLbl)
labelMode   = input.string("HH / HL / LH / LL", "Label Text", options = ["HH / HL / LH / LL", "HH / HL / LH / LL + Price", "SH / SL", "Price"], group = grpLbl,
     tooltip = "HH = Higher High, LH = Lower High, HL = Higher Low, LL = Lower Low, EQH / EQL = Equal High / Low.\nSH / SL = Swing High / Swing Low.")
labelSizeIn = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal"], group = grpLbl)
markVolSwings = input.bool(true, "Mark swings made on strong volume (★)", group = grpLbl,
     tooltip = "Adds a ★ to the label when the swing candle itself had Strong RVOL or higher.")

grpLvl = "Swing Levels"
showLevels  = input.bool(true, "Show swing level lines", group = grpLvl)
maxLevels   = input.int(5, "Max lines per side", minval = 1, maxval = 50, group = grpLvl)
stopOnBreak = input.bool(true, "Stop line when price breaks it", group = grpLvl)
breakType   = input.string("Close", "Break Confirmation", options = ["Close", "Wick"], group = grpLvl,
     tooltip = "Close: a level is broken when a candle CLOSES beyond it.\nWick: a level is broken as soon as a wick touches beyond it.")
lineStyleIn = input.string("Dashed", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = grpLvl)

grpZz = "Zigzag"
showZigzag = input.bool(false, "Show zigzag", group = grpZz)
zzColor    = input.color(color.new(color.gray, 20), "Zigzag Color", group = grpZz)
zzWidth    = input.int(1, "Zigzag Width", minval = 1, maxval = 4, group = grpZz)

// ── Colors ──
grpCol = "Colors"
buyColor  = input.color(color.new(color.green, 0), "Buy Volume Candle",  group = grpCol)
sellColor = input.color(color.new(color.red, 0),   "Sell Volume Candle", group = grpCol)
highColor = input.color(color.red,   "Swing High", group = grpCol)
lowColor  = input.color(color.green, "Swing Low",  group = grpCol)

// ═════════════════════════════════════════════════════════════
// RVOL
// ═════════════════════════════════════════════════════════════

// ── Simple mode: average of the last N bars ──
volSrc    = excludeCurrent ? volume[1] : volume
smaVol    = ta.sma(volSrc, length)
emaVol    = ta.ema(volSrc, length)
medianVol = ta.median(volSrc, length)
simpleAvg = avgType == "SMA" ? smaVol : avgType == "EMA" ? emaVol : medianVol

// ── Time of Day mode: average volume at the same time in previous sessions ──
type VolHistory
    array<float> vols

var map<int, VolHistory> todHistory = map.new<int, VolHistory>()

useTod = mode == "Time of Day" and timeframe.isintraday
todKey = hour(time) * 3600 + minute(time) * 60 + second(time)

float todAvg = na
if useTod
    VolHistory hist = todHistory.get(todKey)
    if na(hist)
        hist := VolHistory.new(array.new<float>())
        todHistory.put(todKey, hist)
    if hist.vols.size() > 0
        todAvg := avgType == "Median" ? hist.vols.median() : hist.vols.avg()
    // Store this bar's volume only once the bar has closed
    if barstate.isconfirmed
        hist.vols.push(volume)
        if hist.vols.size() > length
            hist.vols.shift()

// ── Buy / sell split, method 1: Intrabar (tick rule on lower-timeframe closes) ──
autoLtf = timeframe.isseconds ? "1S" : timeframe.isintraday ? "1" : timeframe.isdaily ? "5" : "60"
ltf     = customLtf == "" ? autoLtf : customLtf

[ibClose, ibVol] = request.security_lower_tf(syminfo.tickerid, ltf, [close, volume], ignore_invalid_timeframe = true)

var float prevIbClose = na
var int   lastDir     = 1
float ibBuy  = 0.0
float ibSell = 0.0
int   ibCount = ibClose.size()
if ibCount > 0
    for i = 0 to ibCount - 1
        float c = ibClose.get(i)
        float v = nz(ibVol.get(i))
        if not na(prevIbClose)
            if c > prevIbClose
                lastDir := 1
            else if c < prevIbClose
                lastDir := -1
        if lastDir == 1
            ibBuy += v
        else
            ibSell += v
        prevIbClose := c

// ── Buy / sell split, method 2: Candle Range ──
rng       = high - low
rangeBuy  = rng > 0 ? volume * (close - low) / rng : volume * 0.5
rangeSell = volume - rangeBuy

// ── Pick the method (fall back to Candle Range when no intrabar data exists for this bar) ──
ibTotal     = ibBuy + ibSell
useIntrabar = splitMethod == "Intrabar" and ibTotal > 0
buyVol      = useIntrabar ? volume * ibBuy / ibTotal : rangeBuy
sellVol     = useIntrabar ? volume - buyVol          : rangeSell
delta       = buyVol - sellVol
buyPct      = volume > 0 ? buyVol / volume * 100 : 50.0
sellPct     = 100 - buyPct

// ── RVOL ──
avgVol = useTod ? todAvg : simpleAvg
rvol   = avgVol > 0 ? nz(volume) / avgVol : na

buyDominant  = buyPct  >= dominance
sellDominant = sellPct >= dominance

isStrong  = not na(rvol) and rvol >= highLvl
isExtreme = not na(rvol) and rvol >= extremeLvl

strongBuy   = isStrong  and buyDominant
strongSell  = isStrong  and sellDominant
extremeBuy  = isExtreme and buyDominant
extremeSell = isExtreme and sellDominant

// ── Candle highlighting ──
highlightBuy  = strongBuy  and buyVol  >= sellVol
highlightSell = strongSell and sellVol >  buyVol
isHighlighted = highlightBuy or highlightSell
isFullColor   = extremeBuy or extremeSell

candleColor = not isHighlighted ? (dimOthers ? color.new(color.gray, 70) : na) :
     color.new(highlightBuy ? buyColor : sellColor, isFullColor ? 0 : strongShade)

barcolor(showRvol ? candleColor : na, title = "RVOL Candle Highlight")

// ── Info table (current candle) ──
var table info = table.new(position.bottom_right, 2, 6, bgcolor = color.new(color.black, 80), border_width = 1)

if showRvol and showTable and barstate.islast
    sideColor   = buyVol >= sellVol ? buyColor : sellColor
    methodLabel = useIntrabar ? "Intrabar (" + ltf + ")" : splitMethod == "Intrabar" ? "Candle Range (no intrabar data)" : "Candle Range"
    table.cell(info, 0, 0, "RVOL",     text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, na(rvol) ? "n/a" : str.tostring(rvol, "#.##") + "x", text_color = sideColor, text_size = size.small)
    table.cell(info, 0, 1, "Buy Vol",  text_color = color.white, text_size = size.small)
    table.cell(info, 1, 1, str.tostring(buyVol, format.volume) + "  (" + str.tostring(buyPct, "#") + "%)", text_color = buyColor, text_size = size.small)
    table.cell(info, 0, 2, "Sell Vol", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 2, str.tostring(sellVol, format.volume) + "  (" + str.tostring(sellPct, "#") + "%)", text_color = sellColor, text_size = size.small)
    table.cell(info, 0, 3, "Delta",    text_color = color.white, text_size = size.small)
    table.cell(info, 1, 3, (delta >= 0 ? "+" : "") + str.tostring(delta, format.volume), text_color = delta >= 0 ? buyColor : sellColor, text_size = size.small)
    table.cell(info, 0, 4, "Avg Vol",  text_color = color.white, text_size = size.small)
    table.cell(info, 1, 4, na(avgVol) ? "n/a" : str.tostring(avgVol, format.volume), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 5, "Split",    text_color = color.white, text_size = size.small)
    table.cell(info, 1, 5, methodLabel, text_color = color.white, text_size = size.small)

// ═════════════════════════════════════════════════════════════
// SWING HIGHS & LOWS
// ═════════════════════════════════════════════════════════════
lblSize   = labelSizeIn == "Tiny" ? size.tiny : labelSizeIn == "Small" ? size.small : size.normal
lineStyle = lineStyleIn == "Solid" ? line.style_solid : lineStyleIn == "Dashed" ? line.style_dashed : line.style_dotted

srcHigh      = swingSrc == "Wicks" ? high : math.max(open, close)
srcLow       = swingSrc == "Wicks" ? low  : math.min(open, close)
breakHighSrc = breakType == "Close" ? close : high
breakLowSrc  = breakType == "Close" ? close : low

// ── Swing detection ──
ph     = ta.pivothigh(srcHigh, leftBars, rightBars)
pl     = ta.pivotlow(srcLow, leftBars, rightBars)
pivotX = bar_index - rightBars

isNewHigh = showSwings and not na(ph)
isNewLow  = showSwings and not na(pl)

// Was the swing candle itself a strong-volume candle?
pivotStrongVol = isStrong[rightBars]

// ── Types and helpers ──
type SwingLevel
    line  ln
    float price
    bool  broken = false

type ZigZag
    int   x   = na
    float y   = na
    int   dir = 0
    line  ln  = na

f_labelText(string tag, float price, bool isHigh, bool volMark) =>
    string structure = labelMode == "SH / SL" ? (isHigh ? "SH" : "SL") : tag
    string priceTxt  = str.tostring(price, format.mintick)
    string txt = switch labelMode
        "Price"                     => priceTxt
        "HH / HL / LH / LL + Price" => structure + "\n" + priceTxt
        => structure
    volMark ? "★ " + txt : txt

f_addLevel(array<SwingLevel> levels, int x, float y, color c) =>
    line ln = line.new(x, y, bar_index, y, color = c, style = lineStyle, width = 1)
    levels.push(SwingLevel.new(ln, y))
    if levels.size() > maxLevels
        SwingLevel oldest = levels.shift()
        oldest.ln.delete()

f_updateLevels(array<SwingLevel> levels, bool isHigh) =>
    for lvl in levels
        if not lvl.broken
            lvl.ln.set_x2(bar_index)
            if stopOnBreak and (isHigh ? breakHighSrc > lvl.price : breakLowSrc < lvl.price)
                lvl.broken := true

f_zigzag(ZigZag z, int x, float y, int dir) =>
    if z.dir == dir
        // Two swings in the same direction: keep only the more extreme one
        if (dir == 1 and y > z.y) or (dir == -1 and y < z.y)
            if not na(z.ln)
                z.ln.set_xy2(x, y)
            z.x := x
            z.y := y
    else
        if not na(z.x)
            z.ln := line.new(z.x, z.y, x, y, color = zzColor, width = zzWidth)
        z.x   := x
        z.y   := y
        z.dir := dir

// ── State ──
var float lastHigh   = na
var float lastLow    = na
var bool  highBroken = false
var bool  lowBroken  = false

var array<SwingLevel> highLevels = array.new<SwingLevel>()
var array<SwingLevel> lowLevels  = array.new<SwingLevel>()
var ZigZag zz = ZigZag.new()

// ── Break of the most recent swing (for alerts) ──
bool brokeHigh = false
bool brokeLow  = false
if showSwings and not na(lastHigh) and not highBroken and breakHighSrc > lastHigh
    highBroken := true
    brokeHigh  := true
if showSwings and not na(lastLow) and not lowBroken and breakLowSrc < lastLow
    lowBroken := true
    brokeLow  := true

// ── Swing level lines: extend active lines, stop them when broken ──
if showSwings and showLevels
    f_updateLevels(highLevels, true)
    f_updateLevels(lowLevels, false)

// ── New swing high ──
if isNewHigh
    string tag = na(lastHigh) ? "SH" : ph > lastHigh ? "HH" : ph < lastHigh ? "LH" : "EQH"
    if showLabels
        label.new(pivotX, ph, f_labelText(tag, ph, true, markVolSwings and pivotStrongVol), yloc = yloc.abovebar,
             style = label.style_label_down, color = color.new(color.black, 100), textcolor = highColor, size = lblSize)
    if showLevels
        f_addLevel(highLevels, pivotX, ph, highColor)
    if showZigzag
        f_zigzag(zz, pivotX, ph, 1)
    lastHigh   := ph
    highBroken := false

// ── New swing low ──
if isNewLow
    string tag = na(lastLow) ? "SL" : pl < lastLow ? "LL" : pl > lastLow ? "HL" : "EQL"
    if showLabels
        label.new(pivotX, pl, f_labelText(tag, pl, false, markVolSwings and pivotStrongVol), yloc = yloc.belowbar,
             style = label.style_label_up, color = color.new(color.black, 100), textcolor = lowColor, size = lblSize)
    if showLevels
        f_addLevel(lowLevels, pivotX, pl, lowColor)
    if showZigzag
        f_zigzag(zz, pivotX, pl, -1)
    lastLow   := pl
    lowBroken := false

// ═════════════════════════════════════════════════════════════
// ALERTS
// ═════════════════════════════════════════════════════════════
alertcondition(strongBuy,   "Strong Buy Volume",   "Strong buy volume: high RVOL with buyers dominating")
alertcondition(strongSell,  "Strong Sell Volume",  "Strong sell volume: high RVOL with sellers dominating")
alertcondition(extremeBuy,  "Extreme Buy Volume",  "Extreme buy volume: extreme RVOL with buyers dominating")
alertcondition(extremeSell, "Extreme Sell Volume", "Extreme sell volume: extreme RVOL with sellers dominating")
alertcondition(isNewHigh,   "New Swing High",      "A new swing high was confirmed")
alertcondition(isNewLow,    "New Swing Low",       "A new swing low was confirmed")
alertcondition(brokeHigh,   "Swing High Broken",   "Price broke above the last swing high")
alertcondition(brokeLow,    "Swing Low Broken",    "Price broke below the last swing low")
alertcondition(isNewHigh and pivotStrongVol, "Swing High on Strong Volume", "A swing high formed on a strong-volume candle")
alertcondition(isNewLow  and pivotStrongVol, "Swing Low on Strong Volume",  "A swing low formed on a strong-volume candle")
