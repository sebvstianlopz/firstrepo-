//@version=6
indicator("Relative Volume (RVOL)", shorttitle = "RVOL", overlay = false, format = format.price, precision = 2)

// ─────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────
grpCalc = "Calculation"
mode           = input.string("Simple", "Mode", options = ["Simple", "Time of Day"], group = grpCalc,
     tooltip = "Simple: current volume vs the average of the last N bars.\nTime of Day: current volume vs the average volume at the same time of day over the last N sessions (intraday charts only).")
length         = input.int(20, "Lookback (bars / sessions)", minval = 1, group = grpCalc)
avgType        = input.string("SMA", "Average Type", options = ["SMA", "EMA", "Median"], group = grpCalc,
     tooltip = "In Time of Day mode, SMA and EMA both use a simple mean.")
excludeCurrent = input.bool(true, "Exclude current bar from average", group = grpCalc,
     tooltip = "Simple mode only. Compares the current bar to the average of the previous N bars.")

grpLvl = "Thresholds"
lowLvl     = input.float(0.5, "Low RVOL",     minval = 0, step = 0.1, group = grpLvl)
highLvl    = input.float(2.0, "High RVOL",    minval = 0, step = 0.1, group = grpLvl)
extremeLvl = input.float(3.0, "Extreme RVOL", minval = 0, step = 0.1, group = grpLvl)

grpCol = "Colors"
colLow     = input.color(color.new(color.gray, 40),   "Low",          group = grpCol)
colNormal  = input.color(color.new(color.blue, 40),   "Below Average", group = grpCol)
colAbove   = input.color(color.new(color.teal, 20),   "Above Average", group = grpCol)
colHigh    = input.color(color.new(color.orange, 0),  "High",         group = grpCol)
colExtreme = input.color(color.new(color.fuchsia, 0), "Extreme",      group = grpCol)

grpVis = "Display"
colorBars = input.bool(false, "Color price bars by RVOL", group = grpVis)
showTable = input.bool(true,  "Show info table",          group = grpVis)

// ─────────────────────────────────────────────────────────────
// Volume check
// ─────────────────────────────────────────────────────────────
cumVol = ta.cum(nz(volume))
if barstate.islast and cumVol == 0
    runtime.error("No volume data is available for this symbol.")

// ─────────────────────────────────────────────────────────────
// Simple mode: average of the last N bars
// ─────────────────────────────────────────────────────────────
volSrc    = excludeCurrent ? volume[1] : volume
smaVol    = ta.sma(volSrc, length)
emaVol    = ta.ema(volSrc, length)
medianVol = ta.median(volSrc, length)
simpleAvg = avgType == "SMA" ? smaVol : avgType == "EMA" ? emaVol : medianVol

// ─────────────────────────────────────────────────────────────
// Time of Day mode: average volume at the same time in previous sessions
// ─────────────────────────────────────────────────────────────
type VolHistory
    array<float> vols

var map<int, VolHistory> todHistory = map.new<int, VolHistory>()

useTod = mode == "Time of Day" and timeframe.isintraday
todKey = hour(time) * 3600 + minute(time) * 60 + second(time)

float todAvg = na
if useTod
    VolHistory hist = todHistory.get(todKey)
    if na(hist)
        hist := VolHistory.new(array.new<float>())
        todHistory.put(todKey, hist)
    if hist.vols.size() > 0
        todAvg := avgType == "Median" ? hist.vols.median() : hist.vols.avg()
    // Store this bar's volume only once the bar has closed
    if barstate.isconfirmed
        hist.vols.push(volume)
        if hist.vols.size() > length
            hist.vols.shift()

// ─────────────────────────────────────────────────────────────
// RVOL
// ─────────────────────────────────────────────────────────────
avgVol = useTod ? todAvg : simpleAvg
rvol   = avgVol > 0 ? volume / avgVol : na

rvolColor = na(rvol)           ? color.gray :
     rvol >= extremeLvl        ? colExtreme :
     rvol >= highLvl           ? colHigh    :
     rvol >= 1.0               ? colAbove   :
     rvol <= lowLvl            ? colLow     : colNormal

// ─────────────────────────────────────────────────────────────
// Plots
// ─────────────────────────────────────────────────────────────
plot(rvol, "RVOL", color = rvolColor, style = plot.style_columns, linewidth = 2)
hline(1.0,        "Average", color = color.new(color.gray, 30),    linestyle = hline.style_dashed)
hline(highLvl,    "High",    color = color.new(color.orange, 40),  linestyle = hline.style_dotted)
hline(extremeLvl, "Extreme", color = color.new(color.fuchsia, 40), linestyle = hline.style_dotted)

barcolor(colorBars ? rvolColor : na)

// ─────────────────────────────────────────────────────────────
// Info table
// ─────────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 80), border_width = 1)

if showTable and barstate.islast
    modeLabel = mode == "Time of Day" and not timeframe.isintraday ? "Simple (ToD needs intraday)" : mode
    table.cell(info, 0, 0, "RVOL",    text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, na(rvol) ? "n/a" : str.tostring(rvol, "#.##") + "x", text_color = rvolColor, text_size = size.small)
    table.cell(info, 0, 1, "Volume",  text_color = color.white, text_size = size.small)
    table.cell(info, 1, 1, str.tostring(volume, format.volume), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 2, "Avg Vol", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 2, na(avgVol) ? "n/a" : str.tostring(avgVol, format.volume), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 3, "Mode",    text_color = color.white, text_size = size.small)
    table.cell(info, 1, 3, modeLabel, text_color = color.white, text_size = size.small)

// ─────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────
alertcondition(ta.crossover(rvol, highLvl),    "RVOL High",    "RVOL crossed above the High threshold")
alertcondition(ta.crossover(rvol, extremeLvl), "RVOL Extreme", "RVOL crossed above the Extreme threshold")
