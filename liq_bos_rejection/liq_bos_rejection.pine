//@version=6
indicator("1H Sweep/BOS + 5m Volume Rejection", shorttitle = "SwpBOS", overlay = true, max_boxes_count = 300, max_lines_count = 300, max_labels_count = 500)

// =====================================================================================
// STEP 1 - 1H STRUCTURE (closed 1H candles only, no repainting)
//   Swing high / low = 1H pivot (length below).
//   BOS   : a 1H candle CLOSES beyond the last swing high (bullish) or swing low (bearish).
//   SWEEP : a 1H candle wicks beyond the last swing high / low but CLOSES back inside.
//   Bias  : the direction of the latest 1H event (bullish BOS or sweep of a low = bullish).
//
// STEP 2 - ZONES created by every 1H event (shown as boxes, live for "Zone life" hours)
//   BOS level  : the broken swing level -> retest area (support after a bullish BOS, resistance after bearish)
//   BOS origin : the last opposite 1H candle before the break (demand / supply where the move started)
//   Sweep      : the wick area of the sweep candle
//   A zone is removed when price closes clearly through it, when its life ends, or after it gives a signal.
//
// STEP 3 - 5m REJECTION SIGNAL
//   BUY  (at a bullish zone): the candle trades into the zone, CLOSES back above it, has a long lower wick,
//                             and its volume is well above average.
//   SELL (at a bearish zone): mirror image.
//   With "Only trade with 1H bias" on, BUY needs a bullish 1H bias and SELL a bearish one.
//
// Results table: every signal is followed as a trade (stop beyond the rejection wick, target R:R)
// so you can see on your own chart how often the signals worked.
// Backtest on fresh data (OANDA & COMEX 5m Sep 21 - Oct 15 2026, OANDA 15m Jul 31 - Oct 15):
// default rules gave only 5-15 signals per sample and 75-80% of them lost - not a proven edge.
// =====================================================================================

// ---------------------------------------------------------------- inputs
string GA = "1H structure"
int   swingLen  = input.int(3, "Swing length (1H candles each side)", minval = 1, group = GA)
bool  showEvt   = input.bool(true, "Show BOS / SWEEP labels", group = GA)

string GB = "Zones"
bool  zBosLvl   = input.bool(true, "BOS level zones", group = GB)
bool  zOrigin   = input.bool(true, "BOS origin (demand / supply) zones", group = GB)
bool  zSweep    = input.bool(true, "Sweep zones", group = GB)
float lvlDepth  = input.float(0.35, "BOS level zone depth (x 1H ATR)", minval = 0.05, step = 0.05, group = GB)
float maxOrigin = input.float(1.0, "Max origin zone height (x 1H ATR)", minval = 0.1, step = 0.1, group = GB)
float lifeHrs   = input.float(24, "Zone life (hours)", minval = 1, group = GB)
float killBuf   = input.float(0.25, "Remove zone when closing beyond it by (x 1H ATR)", minval = 0, step = 0.05, group = GB)
bool  showZones = input.bool(true, "Show zones", group = GB)

string GC = "5m rejection"
float volMult   = input.float(1.8, "Volume >= x average", minval = 1.0, step = 0.1, group = GC)
int   volLen    = input.int(20, "Volume average length", minval = 5, group = GC)
float wickPct   = input.float(50, "Rejection wick >= % of candle", minval = 10, maxval = 90, step = 5, group = GC)
bool  useBias   = input.bool(true, "Only trade with 1H bias", group = GC)
bool  allowBuy  = input.bool(true, "BUY signals", group = GC, inline = "s")
bool  allowSell = input.bool(true, "SELL signals", group = GC, inline = "s")

string GD = "Trade lines & results"
bool  showSLTP  = input.bool(true, "Show stop / target lines", group = GD)
float rr        = input.float(2.0, "Target (R:R)", minval = 0.5, step = 0.5, group = GD)
float stopBuf   = input.float(0.2, "Stop beyond wick (x ATR)", minval = 0, step = 0.05, group = GD)
float maxHold   = input.float(8, "Count trade as closed after (hours)", minval = 1, group = GD)
float spreadUsd = input.float(0.30, "Spread / cost ($)", minval = 0, step = 0.05, group = GD)
bool  showTbl   = input.bool(true, "Show results table", group = GD)

color cBull = input.color(color.new(#26a69a, 75), "Bullish zone", group = "Colours", inline = "c")
color cBear = input.color(color.new(#ef5350, 75), "Bearish zone", group = "Colours", inline = "c")

// ---------------------------------------------------------------- chart-timeframe values
int   secs      = timeframe.in_seconds()
bool  okTf      = timeframe.isintraday and secs < 3600
float perHour   = 3600.0 / secs
int   lifeBars  = int(math.round(lifeHrs * perHour))
int   holdBars  = int(math.round(maxHold * perHour))
float atrC      = ta.atr(14)
float avgVol    = ta.sma(volume, volLen)[1]
bool  closedBar = barstate.isconfirmed

// ---------------------------------------------------------------- 1H data (previous closed 1H candle)
hourData() =>
    float pH  = ta.pivothigh(high, swingLen, swingLen)
    float pL  = ta.pivotlow(low, swingLen, swingLen)
    int   pHt = na(pH) ? na : time[swingLen]
    int   pLt = na(pL) ? na : time[swingLen]
    [open[1], high[1], low[1], close[1], ta.atr(14)[1], time[1], pH[1], pL[1], pHt[1], pLt[1]]

[hO, hH, hL, hC, hAtr, hT, hPH, hPL, hPHt, hPLt] = request.security(syminfo.tickerid, "60", hourData(), lookahead = barmerge.lookahead_on)
bool hourClosed = not na(hT) and hT != nz(hT[1])

// ---------------------------------------------------------------- state
type Zone
    float top
    float bot
    int   dir        // 1 bullish (look for BUY), -1 bearish (look for SELL)
    int   kind       // 0 BOS level, 1 BOS origin, 2 Sweep
    float atr1
    int   start
    box   bx

type Pos
    int   dir
    int   kind
    float entry
    float stop
    float target
    int   bar
    line  ls
    line  lt

var array<Zone> zones = array.new<Zone>()
var array<Pos>  open_ = array.new<Pos>()
var array<float> hOpen  = array.new<float>()   // last 1H candles (for the BOS origin)
var array<float> hHigh  = array.new<float>()
var array<float> hLow   = array.new<float>()
var array<float> hClose = array.new<float>()
var float swingHi  = na
var int   swingHiT = na
var float swingLo  = na
var int   swingLoT = na
var int   bias     = 0

// results: 0 all, 1 BOS level, 2 BOS origin, 3 Sweep
var array<int>   resN = array.new_int(4, 0)
var array<int>   resF = array.new_int(4, 0)
var array<float> resR = array.new_float(4, 0.0)

kindText(int k) =>
    k == 0 ? "BOS level" : k == 1 ? "BOS origin" : "Sweep"

makeZone(float top, float bot, int dir, int kind, float a, int leftTime) =>
    box b = na
    if showZones
        b := box.new(leftTime, top, time, bot, xloc = xloc.bar_time, extend = extend.right,
             bgcolor = dir == 1 ? cBull : cBear, border_color = dir == 1 ? color.new(cBull, 30) : color.new(cBear, 30),
             text = kindText(kind), text_size = size.tiny, text_color = dir == 1 ? color.new(cBull, 0) : color.new(cBear, 0),
             text_halign = text.align_right, text_valign = text.align_top)
    zones.push(Zone.new(top, bot, dir, kind, a, bar_index, b))
    top

// ---------------------------------------------------------------- 1) 1H events (once per closed 1H candle)
int evtBull = 0
int evtBear = 0
if closedBar and okTf and hourClosed and not na(hAtr)
    // remember the closed 1H candle
    hOpen.push(hO)
    hHigh.push(hH)
    hLow.push(hL)
    hClose.push(hC)
    if hOpen.size() > 12
        hOpen.shift()
        hHigh.shift()
        hLow.shift()
        hClose.shift()
    // new swing points confirmed on this 1H candle
    if not na(hPH)
        swingHi  := hPH
        swingHiT := hPHt
    if not na(hPL)
        swingLo  := hPL
        swingLoT := hPLt
    int n = hOpen.size()
    // swing high: bullish BOS or bearish sweep
    if not na(swingHi)
        if hC > swingHi
            evtBull := 1
            bias := 1
            if zBosLvl
                makeZone(swingHi, swingHi - lvlDepth * hAtr, 1, 0, hAtr, hT)
            if zOrigin and n >= 2
                for k = n - 2 to math.max(0, n - 11)
                    if hClose.get(k) < hOpen.get(k)
                        float top = hOpen.get(k)
                        makeZone(top, math.max(hLow.get(k), top - maxOrigin * hAtr), 1, 1, hAtr, hT)
                        break
            if showEvt
                line.new(swingHiT, swingHi, hT, swingHi, xloc = xloc.bar_time, color = color.new(#26a69a, 0), style = line.style_dashed)
                label.new(hT, swingHi, "BOS", xloc = xloc.bar_time, style = label.style_label_down, size = size.small, color = color.new(#26a69a, 0), textcolor = color.white)
            swingHi := na
        else if hH > swingHi and hC < swingHi
            evtBear := 1
            bias := -1
            if zSweep
                makeZone(hH, swingHi, -1, 2, hAtr, hT)
            if showEvt
                line.new(swingHiT, swingHi, hT, swingHi, xloc = xloc.bar_time, color = color.new(#ef5350, 0), style = line.style_dotted)
                label.new(hT, hH, "SWEEP", xloc = xloc.bar_time, style = label.style_label_down, size = size.small, color = color.new(#ef5350, 0), textcolor = color.white)
            swingHi := na
    // swing low: bearish BOS or bullish sweep
    if not na(swingLo)
        if hC < swingLo
            evtBear := 1
            bias := -1
            if zBosLvl
                makeZone(swingLo + lvlDepth * hAtr, swingLo, -1, 0, hAtr, hT)
            if zOrigin and n >= 2
                for k = n - 2 to math.max(0, n - 11)
                    if hClose.get(k) > hOpen.get(k)
                        float bot = hOpen.get(k)
                        makeZone(math.min(hHigh.get(k), bot + maxOrigin * hAtr), bot, -1, 1, hAtr, hT)
                        break
            if showEvt
                line.new(swingLoT, swingLo, hT, swingLo, xloc = xloc.bar_time, color = color.new(#ef5350, 0), style = line.style_dashed)
                label.new(hT, swingLo, "BOS", xloc = xloc.bar_time, style = label.style_label_up, size = size.small, color = color.new(#ef5350, 0), textcolor = color.white)
            swingLo := na
        else if hL < swingLo and hC > swingLo
            evtBull := 1
            bias := 1
            if zSweep
                makeZone(swingLo, hL, 1, 2, hAtr, hT)
            if showEvt
                line.new(swingLoT, swingLo, hT, swingLo, xloc = xloc.bar_time, color = color.new(#26a69a, 0), style = line.style_dotted)
                label.new(hT, hL, "SWEEP", xloc = xloc.bar_time, style = label.style_label_up, size = size.small, color = color.new(#26a69a, 0), textcolor = color.white)
            swingLo := na

// ---------------------------------------------------------------- 2) follow open signals (results table)
if closedBar and okTf
    int np = open_.size()
    if np > 0
        for i = np - 1 to 0
            Pos p = open_.get(i)
            if bar_index > p.bar
                float res = na
                if (p.dir == 1 and low <= p.stop) or (p.dir == -1 and high >= p.stop)
                    res := -1.0
                else if (p.dir == 1 and high >= p.target) or (p.dir == -1 and low <= p.target)
                    res := rr
                else if bar_index - p.bar >= holdBars
                    res := p.dir * (close - p.entry) / math.abs(p.entry - p.stop)
                if not na(p.ls)
                    p.ls.set_x2(bar_index)
                    p.lt.set_x2(bar_index)
                if not na(res)
                    float net = res - spreadUsd / math.abs(p.entry - p.stop)
                    for idx in array.from(0, p.kind + 1)
                        resN.set(idx, resN.get(idx) + 1)
                        resF.set(idx, resF.get(idx) + (net < 0 ? 1 : 0))
                        resR.set(idx, resR.get(idx) + net)
                    open_.remove(i)

// ---------------------------------------------------------------- 3) 5m rejection of the zones
int buyNow  = 0
int sellNow = 0
if closedBar and okTf
    float rng      = high - low
    bool  bigVol   = not na(avgVol) and avgVol > 0 and volume >= volMult * avgVol
    bool  longLow  = rng > 0 and (math.min(open, close) - low) >= wickPct / 100 * rng
    bool  longHigh = rng > 0 and (high - math.max(open, close)) >= wickPct / 100 * rng
    int nz_ = zones.size()
    if nz_ > 0
        for i = nz_ - 1 to 0
            Zone z = zones.get(i)
            bool drop = false
            if bar_index - z.start > lifeBars
                drop := true
            else if (z.dir == 1 and close < z.bot - killBuf * z.atr1) or (z.dir == -1 and close > z.top + killBuf * z.atr1)
                drop := true
            else
                bool biasOk = not useBias or z.dir == bias
                bool buyRej  = z.dir == 1 and allowBuy and buyNow == 0 and low <= z.top and close > z.top and longLow and bigVol
                bool sellRej = z.dir == -1 and allowSell and sellNow == 0 and high >= z.bot and close < z.bot and longHigh and bigVol
                if biasOk and (buyRej or sellRej)
                    int   d    = buyRej ? 1 : -1
                    float stp  = d == 1 ? low - stopBuf * atrC : high + stopBuf * atrC
                    float risk = math.abs(close - stp)
                    float tgt  = close + d * rr * risk
                    string vr  = str.tostring(volume / avgVol, "0.0") + "x volume"
                    label.new(bar_index, d == 1 ? low : high, d == 1 ? "BUY" : "SELL",
                         style = d == 1 ? label.style_label_up : label.style_label_down, size = size.normal,
                         color = d == 1 ? color.new(#00c853, 0) : color.new(#d50000, 0), textcolor = color.white,
                         tooltip = "Rejection of 1H " + kindText(z.kind) + " zone, " + vr + "\nEntry " + str.tostring(close, format.mintick) + "\nStop " + str.tostring(stp, format.mintick) + "\nTarget " + str.tostring(tgt, format.mintick))
                    line l1 = na
                    line l2 = na
                    if showSLTP
                        l1 := line.new(bar_index, stp, bar_index + 1, stp, color = color.new(#ff5252, 0), style = line.style_dashed)
                        l2 := line.new(bar_index, tgt, bar_index + 1, tgt, color = color.new(#00e676, 0), style = line.style_dashed)
                    open_.push(Pos.new(d, z.kind, close, stp, tgt, bar_index, l1, l2))
                    alert("XAUUSD " + (d == 1 ? "BUY" : "SELL") + " | 5m rejection of 1H " + kindText(z.kind) + " zone (" + vr + ")" +
                         " | entry " + str.tostring(close, format.mintick) + " | stop " + str.tostring(stp, format.mintick) +
                         " | target " + str.tostring(tgt, format.mintick), alert.freq_once_per_bar_close)
                    buyNow  += d == 1 ? 1 : 0
                    sellNow += d == -1 ? 1 : 0
                    drop := true
            if drop
                if not na(z.bx)
                    z.bx.set_extend(extend.none)
                    z.bx.set_right(time)
                zones.remove(i)

// ---------------------------------------------------------------- alerts
alertcondition(buyNow > 0, "BUY", "XAUUSD: BUY - 5m high-volume rejection of a 1H BOS / sweep zone")
alertcondition(sellNow > 0, "SELL", "XAUUSD: SELL - 5m high-volume rejection of a 1H BOS / sweep zone")
alertcondition(evtBull > 0, "1H bullish BOS / sweep", "XAUUSD: 1H bullish structure event (BOS up or sweep of a low)")
alertcondition(evtBear > 0, "1H bearish BOS / sweep", "XAUUSD: 1H bearish structure event (BOS down or sweep of a high)")

// ---------------------------------------------------------------- results table
var table t = table.new(position.top_right, 5, 7, bgcolor = color.new(#131722, 10), border_color = color.new(#363a45, 0), border_width = 1)
if barstate.isfirst
    t.merge_cells(0, 5, 4, 5)
    t.merge_cells(0, 6, 4, 6)

if showTbl and barstate.islast
    color fg  = color.new(#d1d4dc, 0)
    color dim = color.new(#9598a1, 0)
    color hd  = color.new(#2a2e39, 0)
    array<string> cols = array.from("Signals from", "Trades", "Fail %", "Avg", "Total")
    for c = 0 to 4
        t.cell(c, 0, cols.get(c), text_color = fg, text_size = size.small, bgcolor = hd)
    array<string> rows = array.from("All zones", "BOS level", "BOS origin", "Sweep")
    for r = 0 to 3
        int   n   = resN.get(r)
        float avg = n > 0 ? resR.get(r) / n : na
        color ac  = na(avg) ? fg : avg > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0)
        t.cell(0, r + 1, rows.get(r), text_color = r == 0 ? fg : dim, text_size = size.small, text_halign = text.align_left)
        t.cell(1, r + 1, str.tostring(n), text_color = fg, text_size = size.small)
        t.cell(2, r + 1, n > 0 ? str.tostring(100.0 * resF.get(r) / n, "0") + "%" : "-", text_color = fg, text_size = size.small)
        t.cell(3, r + 1, na(avg) ? "-" : (avg >= 0 ? "+" : "") + str.tostring(avg, "0.00") + "R", text_color = ac, text_size = size.small)
        t.cell(4, r + 1, n > 0 ? (resR.get(r) >= 0 ? "+" : "") + str.tostring(resR.get(r), "0.0") + "R" : "-", text_color = ac, text_size = size.small)
    string biasTxt = bias == 1 ? "1H bias: BULLISH" : bias == -1 ? "1H bias: BEARISH" : "1H bias: none yet"
    t.cell(0, 5, biasTxt + "   |   live zones: " + str.tostring(zones.size()) + "   |   open: " + str.tostring(open_.size()), text_color = bias == 1 ? color.new(#26a69a, 0) : bias == -1 ? color.new(#ef5350, 0) : dim, text_size = size.small, text_halign = text.align_left)
    t.cell(0, 6, okTf ? "Fail = losing trade. Stop beyond rejection wick, target " + str.tostring(rr, "0.0") + "R." : "Use a chart below 1H (built for 5m)", text_color = dim, text_size = size.tiny, text_halign = text.align_left)
