---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '../styles/tailwind.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { getImage } from 'astro:assets';
import ogImg from '../assets/hero.jpg';
import { t, asset } from '../i18n';
import { site, type Lang } from '../config/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Same page in the other language, as a path. */
  alternate: string;
  image?: ImageMetadata;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Extra class on <body>, e.g. to reserve room for a sticky bar. */
  bodyClass?: string;
}
const { lang, title, description, alternate, image = ogImg, jsonLd, noindex = false, bodyClass } = Astro.props;
const d = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = new URL(alternate, Astro.site);
const esUrl = lang === 'es' ? canonical : alt;
const enUrl = lang === 'en' ? canonical : alt;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);
---
<!doctype html>
<html lang={lang === 'es' ? 'es-DO' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <meta name="theme-color" content="#0b0c0d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'es' ? 'es_DO' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Logo intro: once per visit, never with reduced motion, decided before first paint.
      (function () {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('le:intro')) return;
          sessionStorage.setItem('le:intro', '1');
        } catch (e) {
          return;
        }
        var root = document.documentElement;
        root.classList.add('intro');
        setTimeout(function () {
          root.classList.remove('intro');
        }, 8000);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <Intro />
    <a class="skip" href="#main">{d.skip}</a>
    <Header lang={lang} alternate={alternate} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    background: var(--signal);
    color: var(--on-signal);
    text-decoration: none;
  }
  .skip:focus {
    top: 12px;
  }
</style>
