---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Browse from '../components/home/Browse.astro';
import Steps from '../components/home/Steps.astro';
import Trust from '../components/home/Trust.astro';
import Faq from '../components/home/Faq.astro';
import Closing from '../components/home/Closing.astro';
import Featured from '../components/home/Featured.astro';
import { t, path } from '../i18n';
import type { Lang } from '../config/site';
import { getVehicles } from '../lib/vehicles';
import { businessJsonLd } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const vehicles = (await getVehicles()).filter((v) => v.data.available);
const featured = vehicles.filter((v) => v.data.featured).slice(0, 8);
const other: Lang = lang === 'es' ? 'en' : 'es';
---
<Base
  lang={lang}
  title={d.meta.homeTitle}
  description={d.meta.homeDesc}
  alternate={path(other, 'home')}
  jsonLd={businessJsonLd(lang, Astro.site!, vehicles)}
>
  <Hero lang={lang} vehicles={vehicles} />
  <Browse lang={lang} vehicles={vehicles} />

  <Featured lang={lang} featured={featured} total={vehicles.length} />

  <Steps lang={lang} />
  <Trust lang={lang} />
  <Faq lang={lang} />
  <Closing lang={lang} />
</Base>

