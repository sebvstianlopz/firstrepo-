---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Browse from '../components/home/Browse.astro';
import Steps from '../components/home/Steps.astro';
import Trust from '../components/home/Trust.astro';
import Faq from '../components/home/Faq.astro';
import Closing from '../components/home/Closing.astro';
import VehicleCard from '../components/VehicleCard.astro';
import { t, path } from '../i18n';
import type { Lang } from '../config/site';
import { getVehicles } from '../lib/vehicles';
import { businessJsonLd } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const vehicles = (await getVehicles()).filter((v) => v.data.available);
const featured = vehicles.filter((v) => v.data.featured).slice(0, 8);
const other: Lang = lang === 'es' ? 'en' : 'es';
---
<Base
  lang={lang}
  title={d.meta.homeTitle}
  description={d.meta.homeDesc}
  alternate={path(other, 'home')}
  jsonLd={businessJsonLd(lang, Astro.site!, vehicles)}
>
  <Hero lang={lang} vehicles={vehicles} />
  <Browse lang={lang} vehicles={vehicles} />

  <section class="section" aria-labelledby="featured-title">
    <div class="container">
      <header class="row">
        <h2 id="featured-title">{d.featured.title}</h2>
        <a class="link" href={path(lang, 'catalog')}>{d.featured.all} ({vehicles.length})</a>
      </header>
    </div>
    <div class="cards" tabindex="0" aria-label={d.featured.title}>
      {featured.map((v) => <VehicleCard vehicle={v} lang={lang} />)}
    </div>
  </section>

  <Steps lang={lang} />
  <Trust lang={lang} />
  <Faq lang={lang} />
  <Closing lang={lang} />
</Base>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  /* Horizontal scroller that snaps card by card. */
  .cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(250px, 28vw, 380px);
    gap: clamp(14px, 2vw, 24px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: var(--gutter);
    padding-bottom: 18px;
    scrollbar-width: thin;
    scrollbar-color: var(--signal) var(--panel);
  }
  .cards > :global(*) {
    scroll-snap-align: start;
  }
</style>
