---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BookingPanel from '../components/BookingPanel.astro';
import VehicleCard from '../components/VehicleCard.astro';
import WaButton from '../components/WaButton.astro';
import Icon from '../components/Icon.astro';
import { t, path, formatPrice } from '../i18n';
import { site, type Lang } from '../config/site';
import { getVehicles, vehicleName, nameParts, vehicleFullName, fleetNo, related, forRent, colorHex, type Vehicle } from '../lib/vehicles';
import { vehicleJsonLd } from '../lib/seo';
import { waLink } from '../lib/whatsapp';

interface Props {
  lang: Lang;
  vehicle: Vehicle;
}
const { lang, vehicle: v } = Astro.props;
const d = t(lang);
const data = v.data;
const all = await getVehicles();
const more = related(v, all, 4);
const other: Lang = lang === 'es' ? 'en' : 'es';
const pageUrl = new URL(path(lang, 'catalog', v.id), Astro.site).href;
const og = await getImage({ src: data.photos[0], width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const name = vehicleName(v, lang);
const parts = nameParts(v, lang);
const fullName = vehicleFullName(v, lang);
const Title = fullName.charAt(0).toUpperCase() + fullName.slice(1);
const fleet = fleetNo(v);
const priceLine = data.priceDay
  ? `${formatPrice(data.priceDay, lang, site.currency)}${d.perDay}`
  : data.priceSale
    ? formatPrice(data.priceSale, lang, site.currency)
    : '';

const specs = [
  { icon: 'tag', label: d.vehicle.category, value: d.category[data.category] },
  { icon: 'seats', label: d.vehicle.seatsLabel, value: String(data.seats) },
  data.transmission && { icon: 'gear', label: lang === 'es' ? 'Transmisión' : 'Transmission', value: d.transmission[data.transmission] },
  data.fuel && { icon: 'fuel', label: lang === 'es' ? 'Combustible' : 'Fuel', value: d.fuel[data.fuel] },
  data.year && { icon: 'calendar', label: d.vehicle.year, value: String(data.year) },
].filter(Boolean) as { icon: 'tag'; label: string; value: string }[];
---
<Base
  lang={lang}
  title={`${Title} (${fleet}) | ${priceLine} | Los Eternos`}
  description={`${Title}. ${d.category[data.category]}, ${d.seats(data.seats)}. ${priceLine}. ${d.meta.homeDesc}`}
  alternate={path(other, 'catalog', v.id)}
  image={data.photos[0]}
  jsonLd={vehicleJsonLd(v, lang, Astro.site!, new URL(og.src, Astro.site).href)}
  bodyClass="has-bar"
>
  <div class="container page">
    <nav class="crumbs mono" aria-label={lang === 'es' ? 'Ruta' : 'Breadcrumb'}>
      <a href={path(lang, 'catalog')}><Icon name="chevron-left" size={14} />{d.vehicle.back}</a>
    </nav>

    <div class="layout">
      <div class="gallery">
        <div class="viewer">
        <div class="track" data-track tabindex={data.photos.length > 1 ? 0 : undefined} aria-label={data.photos.length > 1 ? fullName : undefined}>
          {data.photos.map((photo, i) => (
            <figure class="slide" style={`aspect-ratio: ${photo.width} / ${photo.height};${i === 0 ? ` view-transition-name: vt-${v.id}` : ''}`}>
              <Image
                src={photo}
                alt={data.photos.length > 1 ? `${fullName}, ${d.vehicle.photo(i + 1, data.photos.length)}` : fullName}
                widths={[480, 720, 960]}
                sizes="(max-width: 900px) calc(100vw - 32px), 560px"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </figure>
          ))}
        </div>
        {/* Spec-sheet overlay: thirds, crosshairs at the intersections, fleet number in a corner cell. */}
        <div class="sheet" aria-hidden="true">
          <i style="left:33.333%;top:33.333%"></i>
          <i style="left:66.666%;top:33.333%"></i>
          <i style="left:33.333%;top:66.666%"></i>
          <i style="left:66.666%;top:66.666%"></i>
          <span class="mono">{fleet}</span>
        </div>
        </div>
        {data.photoPending && <p class="pending mono">{d.vehicle.photoPending}</p>}
      </div>

      <div class="info">
        <header class="title">
          <p class="kicker mono"><span>{fleet}</span><span>{d.category[data.category]}</span></p>
          <h1>
            {parts.brand && <span class="brand mono">{parts.brand}</span>}
            <span class="model">{parts.model}</span>
          </h1>
          <p class="sub mono">
            <span class="swatch" style={`background:${colorHex[data.color]}`} aria-hidden="true"></span>
            {d.color[data.color]}
          </p>
        </header>

        {data.available ? (
          <BookingPanel vehicle={v} lang={lang} pageUrl={pageUrl} />
        ) : (
          <div class="unavailable">
            <p>{d.vehicle.unavailable}</p>
            <WaButton lang={lang} label={d.wa.write} />
          </div>
        )}

        <section aria-labelledby="specs-title">
          <h2 id="specs-title" class="h-small">{d.vehicle.specs}</h2>
          <dl class="specs">
            {specs.map((s) => (
              <div>
                <dt><Icon name={s.icon} size={16} />{s.label}</dt>
                <dd class="mono">{s.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        {data.highlights.length > 0 && (
          <section aria-labelledby="hl-title">
            <h2 id="hl-title" class="h-small">{d.vehicle.highlights}</h2>
            <ul class="highlights">
              {data.highlights.map((h) => <li><Icon name="check" size={16} />{h[lang]}</li>)}
            </ul>
          </section>
        )}

        {data.description && <p class="desc">{data.description[lang]}</p>}
      </div>
    </div>
  </div>

  {more.length > 0 && (
    <section class="section more" aria-labelledby="more-title">
      <div class="container">
        <h2 id="more-title">{d.vehicle.more}</h2>
        <div class="cards">
          {more.map((m) => <VehicleCard vehicle={m} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  {data.available && (
    <div class="bar" data-bar>
      <p>
        <span class="price">{priceLine}</span>
        <span class="bar-name mono">{fleet} {name}</span>
      </p>
      <a
        class="btn btn-primary bar-btn"
        href={waLink(forRent(v) && data.priceDay ? { kind: 'rent', car: fullName, fleet, place: site.locations[0].label[lang], url: pageUrl } : { kind: 'sale', car: fullName, fleet, url: pageUrl }, lang)}
        target="_blank"
        rel="noopener"
        data-wa
      >
        <Icon name="whatsapp" size={18} />
        <span data-wa-label>{forRent(v) ? d.wa.book : d.wa.visit}</span>
      </a>
    </div>
  )}
</Base>

<script>
  // Show the bottom bar on phones only while the booking button is off screen.
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  const target = document.querySelector('[data-booking] .bk-btn');
  if (bar && target && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => bar.classList.toggle('is-visible', !entry.isIntersecting)).observe(target);
  }
</script>

<style>
  .page {
    padding-block: 20px clamp(56px, 8vw, 104px);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
    margin-top: 12px;
  }
  .gallery {
    position: sticky;
    top: 100px;
  }
  .viewer {
    position: relative;
  }
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--r-img);
    background: var(--panel);
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    margin: 0 auto;
    width: 100%;
    max-height: calc(100svh - 140px);
    scroll-snap-align: start;
  }
  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sheet {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: var(--r-img);
    background:
      linear-gradient(90deg, transparent calc(33.333% - 0.5px), rgb(242 240 236 / 0.22) calc(33.333% - 0.5px) calc(33.333% + 0.5px), transparent calc(33.333% + 0.5px) calc(66.666% - 0.5px), rgb(242 240 236 / 0.22) calc(66.666% - 0.5px) calc(66.666% + 0.5px), transparent calc(66.666% + 0.5px)),
      linear-gradient(0deg, transparent calc(33.333% - 0.5px), rgb(242 240 236 / 0.22) calc(33.333% - 0.5px) calc(33.333% + 0.5px), transparent calc(33.333% + 0.5px) calc(66.666% - 0.5px), rgb(242 240 236 / 0.22) calc(66.666% - 0.5px) calc(66.666% + 0.5px), transparent calc(66.666% + 0.5px));
  }
  .sheet i {
    position: absolute;
    width: 13px;
    height: 13px;
    transform: translate(-50%, -50%);
    background:
      linear-gradient(var(--text), var(--text)) center / 13px 1px no-repeat,
      linear-gradient(var(--text), var(--text)) center / 1px 13px no-repeat;
  }
  .sheet span {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 4px 8px;
    background: rgb(11 12 13 / 0.78);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 0.75rem;
    color: var(--text);
  }
  .pending {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .info {
    min-width: 0;
    display: grid;
    gap: 36px;
    max-width: 560px;
  }
  .title {
    display: grid;
    gap: 14px;
  }
  .kicker {
    display: flex;
    gap: 14px;
    color: var(--muted);
  }
  .kicker span:first-child {
    color: var(--signal-text);
  }
  h1 {
    display: grid;
    gap: 10px;
    font-size: inherit;
  }
  .brand {
    font-size: 0.85rem;
    font-weight: 400;
    font-stretch: 100%;
    line-height: 1;
    color: var(--muted);
  }
  .model {
    font-size: clamp(2.2rem, 1.2rem + 3.6vw, 4.6rem);
    line-height: 0.92;
    overflow-wrap: anywhere;
  }
  .sub {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
  }
  .swatch {
    width: 10px;
    height: 10px;
    box-shadow: inset 0 0 0 1px rgb(242 240 236 / 0.4);
  }
  .h-small {
    margin-bottom: 14px;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .specs {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .specs div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 13px;
    border-bottom: 1px solid var(--line);
  }
  .specs dt {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
  }
  .specs dd {
    margin: 0;
    color: var(--text);
  }
  .highlights {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .highlights li {
    display: flex;
    gap: 10px;
  }
  .highlights :global(svg) {
    color: var(--signal-text);
    flex: none;
    margin-top: 5px;
  }
  .desc {
    font-size: var(--step-1);
    line-height: 1.55;
    color: rgb(242 240 236 / 0.85);
  }
  .unavailable {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding: 24px;
    background: var(--panel);
  }
  .more {
    border-top: 1px solid var(--line);
  }
  .more h2 {
    font-size: var(--step-2);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px clamp(14px, 2vw, 24px);
    margin-top: clamp(28px, 4vw, 48px);
  }

  .bar {
    display: none;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .gallery {
      position: relative;
      top: auto;
    }
    .slide {
      max-height: 70svh;
    }
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
      background: rgb(22 24 26 / 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-top: 1px solid var(--line);
      transform: translateY(110%);
      transition: transform 0.3s var(--ease);
    }
    .bar.is-visible {
      transform: none;
    }
    .bar p {
      display: grid;
      min-width: 0;
      line-height: 1.35;
    }
    .bar-name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--muted);
      font-size: 0.75rem;
    }
    .bar-btn {
      flex: none;
      padding-inline: 1.1em;
    }
    :global(body.has-bar) {
      padding-bottom: 76px;
    }
  }
</style>
