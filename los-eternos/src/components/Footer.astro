---
import Icon from './Icon.astro';
import { t, path } from '../i18n';
import { site, type Lang } from '../config/site';
import { waLink } from '../lib/whatsapp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div>
        <p class="wordmark">Los Eternos</p>
        <p class="mono muted tagline">{d.footer.tagline}</p>
      </div>
      <nav aria-label={lang === 'es' ? 'Pie de página' : 'Footer'}>
        <ul>
          <li><a href={path(lang, 'catalog')}>{d.nav.catalog}</a></li>
          <li><a href={path(lang, 'services')}>{d.nav.services}</a></li>
          <li><a href={path(lang, 'about')}>{d.nav.about}</a></li>
        </ul>
      </nav>
      <ul class="contact">
        <li>
          <a href={waLink({ kind: 'general' }, lang)} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={18} /> WhatsApp {site.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`tel:+${site.whatsapp}`}><Icon name="phone" size={18} /> {site.phoneDisplay}</a>
        </li>
        <li>
          <a href={site.social.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Instagram</a>
        </li>
        <li class="muted"><Icon name="clock" size={18} /> {site.hours[lang]}</li>
      </ul>
    </div>
    <p class="legal mono muted">© {year} {site.name}. {d.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 56px 28px;
    font-size: 0.95rem;
  }
  .top {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1.2fr;
    gap: 40px;
  }
  .wordmark {
    font-size: var(--step-1);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
    text-transform: uppercase;
  }
  .tagline {
    margin-top: 14px;
    max-width: 30em;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    text-decoration: none;
    color: var(--text);
  }
  a:hover {
    color: var(--signal-text);
  }
  .legal {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .top {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
