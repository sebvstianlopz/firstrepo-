---
import Icon from '../Icon.astro';
import { t } from '../../i18n';
import type { Lang } from '../../config/site';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang);
---
<section class="section trust" aria-labelledby="trust-title">
  <div class="container grid">
    <h2 id="trust-title">{d.trust.title}</h2>
    <ul>
      {d.trust.items.map((item) => (
        <li>
          <Icon name={item.icon as 'shield'} size={24} class="icon" />
          <div>
            <h3>{item.t}</h3>
            <p class="muted">{item.d}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust {
    background: var(--surface);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 16px;
  }
  li :global(.icon) {
    color: var(--accent);
    margin-top: 2px;
  }
  h3 {
    margin-bottom: 6px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    ul {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
