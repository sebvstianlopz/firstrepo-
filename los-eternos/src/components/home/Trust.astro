---
import Icon from '../Icon.astro';
import { t } from '../../i18n';
import type { Lang } from '../../config/site';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang);
---
<section class="section trust" aria-labelledby="trust-title">
  <div class="container grid">
    <h2 id="trust-title">{d.trust.title}</h2>
    <ul>
      {d.trust.items.map((item) => (
        <li>
          <span class="badge" aria-hidden="true"><Icon name={item.icon as 'shield'} size={18} /></span>
          <div>
            <h3>{item.t}</h3>
            <p class="muted">{item.d}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust {
    background: var(--panel);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
  }
  li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 18px;
    padding: clamp(20px, 3vw, 32px);
    background: var(--panel);
  }
  .badge {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line-strong);
    color: var(--signal-text);
  }
  h3 {
    margin-bottom: 8px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
