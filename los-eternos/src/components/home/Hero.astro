---
import { Image } from 'astro:assets';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import heroImg from '../../assets/hero.jpg';
import { t, path, formatPrice } from '../../i18n';
import { site, cities, type Lang } from '../../config/site';
import { categorySummary, type Vehicle } from '../../lib/vehicles';

interface Props {
  lang: Lang;
  vehicles: Vehicle[];
}
const { lang, vehicles } = Astro.props;
const d = t(lang);
const categories = categorySummary(vehicles).map((c) => c.category);
const prices = vehicles.map((v) => v.data.priceDay).filter((p): p is number => !!p);
const airports = site.locations.map((l) => l.label.es.match(/\((\w{3})\)/)?.[1]).filter(Boolean);
---
<section class="hero">
  <div class="frame">
    <Image
      class="photo"
      src={heroImg}
      alt=""
      widths={[960, 1440, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="glass" aria-hidden="true"></div>
    <div class="scrim" aria-hidden="true"></div>

    <div class="content">
      <h1>
        <span class="visually-hidden">Los Eternos. </span>
        {d.hero.title.map((line) => <span class="line">{line}</span>)}
      </h1>
      <p class="sub">{d.hero.sub}</p>

      <form class="booking" action={path(lang, 'catalog')} method="get" data-hero>
        <div class="field">
          <label for="hero-cat">{d.hero.categoryLabel}</label>
          <select class="select" id="hero-cat" name="cat">
            <option value="">{d.catalog.categoryAll}</option>
            {categories.map((c) => <option value={c}>{d.category[c]}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="hero-city">{d.hero.cityLabel}</label>
          <select class="select" id="hero-city" name="city">
            {cities.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
        <button class="btn btn-primary go" type="submit">
          {d.hero.cta}
          <Icon name="chevron-right" size={18} />
        </button>
      </form>
      <WaButton lang={lang} label={d.wa.write} variant="ghost" class="wa" />
    </div>

    <ul class="data mono" aria-label={lang === 'es' ? 'La flota en cifras' : 'The fleet in numbers'}>
      <li>{d.catalog.count(vehicles.length)}</li>
      {prices.length > 0 && <li>{d.from} {formatPrice(Math.min(...prices), lang, site.currency)}{d.perDay}</li>}
      <li>{airports.join(' / ')}</li>
    </ul>
  </div>

  <a class="rail mono" href="#browse-title">
    <span>{d.hero.scroll}</span>
    <span class="arrow" aria-hidden="true">↓</span>
  </a>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-hero]');
  form?.addEventListener('submit', () => {
    const cat = form.querySelector<HTMLSelectElement>('#hero-cat');
    if (cat && !cat.value) cat.disabled = true; // keep the URL clean
    try {
      sessionStorage.setItem('le:city', form.querySelector<HTMLSelectElement>('#hero-city')?.value ?? '');
    } catch {}
  });
</script>

<style>
  .hero {
    --notch: 52px;
    --corner: 34px;
    position: relative;
    padding: 4px var(--gutter) 0;
  }
  /* The photo sits in a frame with two cut corners and a notch on the right edge
     that holds the scroll rail. */
  .frame {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(calc(100svh - 96px), 900px);
    overflow: hidden;
    background: #1a0806;
    clip-path: polygon(
      0 0,
      calc(100% - var(--corner)) 0,
      100% var(--corner),
      100% 36%,
      calc(100% - var(--notch)) calc(36% + var(--notch)),
      calc(100% - var(--notch)) calc(64% - var(--notch)),
      100% 64%,
      100% 100%,
      var(--corner) 100%,
      0 calc(100% - var(--corner))
    );
  }
  .frame :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 60%;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(11 12 13 / 0.78) 0%, rgb(11 12 13 / 0.35) 42%, transparent 62%),
      linear-gradient(0deg, rgb(11 12 13 / 0.6) 0%, transparent 40%);
  }

  /* Fluted glass: covers the photo on load, then retracts to sit behind the copy. */
  .glass {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: repeating-linear-gradient(
      90deg,
      rgb(255 255 255 / 0.07) 0 1px,
      rgb(0 0 0 / 0.22) 1px 5px,
      rgb(255 255 255 / 0.03) 5px 9px,
      transparent 9px 16px
    );
    backdrop-filter: blur(7px) saturate(1.1);
    -webkit-backdrop-filter: blur(7px) saturate(1.1);
    clip-path: inset(0 60% 0 0);
    animation: glass-open 1.1s 0.15s var(--ease) both;
  }
  @keyframes glass-open {
    from {
      clip-path: inset(0 0 0 0);
    }
  }

  .content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: 22px;
    max-width: 740px;
    padding: clamp(28px, 5vw, 64px);
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  h1 {
    font-size: clamp(3rem, 1.2rem + 6.6vw, 7.4rem);
    line-height: 0.9;
    letter-spacing: -0.015em;
  }
  .line {
    display: block;
    white-space: nowrap;
  }
  .sub {
    max-width: 30em;
    color: rgb(242 240 236 / 0.82);
  }
  .booking {
    --cut: 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    align-items: end;
    gap: 10px;
    width: min(100%, 720px);
    margin-top: 8px;
    padding: 14px;
    background: rgb(22 24 26 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));
  }
  .booking .select {
    background-color: var(--panel-2);
  }
  .go {
    min-height: 50px;
    white-space: nowrap;
  }
  .content :global(.wa) {
    min-height: 44px;
    background: rgb(11 12 13 / 0.3);
  }

  .data {
    position: absolute;
    z-index: 2;
    right: calc(var(--notch) + 24px);
    bottom: 28px;
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: rgb(242 240 236 / 0.75);
  }
  .data li + li::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 22px;
    vertical-align: 1px;
    background: var(--signal);
  }

  .rail {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    width: var(--notch);
    display: grid;
    justify-items: center;
    gap: 10px;
    transform: translateY(-50%);
    color: var(--text);
    text-decoration: none;
  }
  .rail span:first-child {
    writing-mode: vertical-rl;
  }
  .rail .arrow {
    font-family: var(--font);
    animation: nudge 2.4s 1.4s var(--ease) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }

  @media (max-width: 1100px) {
    .data {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .hero {
      --corner: 22px;
      padding-inline: 10px;
    }
    .frame {
      min-height: calc(100svh - 86px);
      clip-path: polygon(
        0 0,
        calc(100% - var(--corner)) 0,
        100% var(--corner),
        100% 100%,
        var(--corner) 100%,
        0 calc(100% - var(--corner))
      );
    }
    .frame :global(.photo) {
      height: 62%;
      object-position: 72% 50%;
    }
    .scrim {
      background: linear-gradient(0deg, var(--bg) 38%, rgb(11 12 13 / 0.7) 52%, transparent 70%);
    }
    .glass {
      clip-path: inset(46% 0 0 0);
    }
    .content {
      padding: 20px 14px 28px;
    }
    .booking {
      grid-template-columns: 1fr 1fr;
      padding: 10px;
    }
    .booking .select {
      padding: 0.6em 1.9em 0.6em 0.7em;
      background-position: right 0.6em center;
      font-size: 0.92rem;
    }
    .go {
      grid-column: 1 / -1;
    }
    .rail {
      display: none;
    }
  }
</style>
