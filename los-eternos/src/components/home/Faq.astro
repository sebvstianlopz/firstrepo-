---
import { t } from '../../i18n';
import type { Lang } from '../../config/site';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang);
---
<section class="section" aria-labelledby="faq-title">
  <div class="container grid">
    <h2 id="faq-title">{d.faq.title}</h2>
    <div class="list">
      {d.faq.items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p class="muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .list {
    border-top: 1px solid var(--line-strong);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    min-height: 68px;
    padding-block: 18px;
    font-size: var(--step-1);
    font-weight: 600;
    font-stretch: 110%;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Plus that turns into a minus. */
  summary::after {
    content: '';
    flex: none;
    width: 14px;
    height: 14px;
    background:
      linear-gradient(var(--signal-text), var(--signal-text)) center / 14px 1.5px no-repeat,
      linear-gradient(var(--signal-text), var(--signal-text)) center / 1.5px 14px no-repeat;
    transition: transform 0.3s var(--ease);
  }
  details[open] summary::after {
    transform: rotate(90deg);
    background: linear-gradient(var(--signal-text), var(--signal-text)) center / 14px 1.5px no-repeat;
  }
  details p {
    max-width: 38em;
    padding-bottom: 26px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
