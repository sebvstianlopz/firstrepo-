---
import { Image } from 'astro:assets';
import { t, path, formatPrice } from '../../i18n';
import { site, type Lang } from '../../config/site';
import { categorySummary, type Vehicle } from '../../lib/vehicles';

interface Props {
  lang: Lang;
  vehicles: Vehicle[];
}
const { lang, vehicles } = Astro.props;
const d = t(lang);
const groups = categorySummary(vehicles);
---
<section class="section browse" aria-labelledby="browse-title">
  <div class="container">
    <header class="head">
      <h2 id="browse-title">{d.browse.title}</h2>
      <p class="lede">{d.browse.text}</p>
    </header>
    <ul class="list">
      {groups.map((g) => (
        <li>
          <a href={`${path(lang, 'catalog')}?cat=${g.category}`}>
            <span class="thumb">
              {g.cover && <Image src={g.cover.data.photos[0]} alt="" widths={[160, 240]} sizes="120px" />}
            </span>
            <span class="label">{d.category[g.category]}</span>
            <span class="meta">
              <span>{d.browse.count(g.count)}</span>
              {g.from && <span>{d.from} <span class="price">{formatPrice(g.from, lang, site.currency)}</span>{d.perDay}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .browse {
    background: var(--surface);
  }
  .head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .thumb {
    width: 72px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--r-img);
    background: var(--sunk);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .label {
    font-size: var(--step-2);
    font-weight: 300;
    font-stretch: var(--wide);
    line-height: 1.15;
    transition: color 0.2s var(--ease), transform 0.3s var(--ease);
  }
  a:hover .label {
    color: var(--accent);
    transform: translateX(6px);
  }
  .meta {
    display: grid;
    justify-items: end;
    gap: 2px;
    color: var(--muted);
    font-size: 0.94rem;
    text-align: right;
  }
  @media (max-width: 600px) {
    a {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 4px 16px;
    }
    .thumb {
      width: 56px;
      grid-row: 1 / 3;
    }
    .label {
      font-size: var(--step-1);
    }
    .meta {
      justify-items: start;
      text-align: left;
      display: flex;
      gap: 12px;
    }
  }
</style>
