---
// Logo loading screen, shown once per visit. It builds the Eternos lockup from its own
// pieces: a red headlight dot spreads into a row of road dashes, each dash stands up
// into a letter of ETERNOS, the car is drawn like a brush stroke (the belt line first,
// so the road becomes the car), and the tagline settles in. Once the page has loaded,
// the screen wipes away left to right, the way the hero car drives. Whether it shows is
// decided by a tiny inline script in <head> (see Base.astro), so the page never flashes.
import '@fontsource/cinzel/latin-400.css';
import logo from '../assets/logo-eternos.svg?raw';
---
<div class="intro" aria-hidden="true" data-intro>
  <div class="lockup">
    <Fragment set:html={logo} />
    <p class="tagline">Luxury Rental Cars</p>
  </div>
</div>

<script>
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const root = document.documentElement;

  if (intro && root.classList.contains('intro')) {
    // The lockup is complete at about 2.7s (see the CSS timeline); hold a beat after it.
    const built = new Promise<void>((resolve) => setTimeout(resolve, 2700 + 350));
    const loaded = new Promise<void>((resolve) =>
      document.readyState === 'complete' ? resolve() : addEventListener('load', () => resolve(), { once: true }),
    );

    let gone = false;
    const leave = () => {
      if (gone) return;
      gone = true;
      intro.classList.add('is-leaving');
      const finish = () => {
        root.classList.remove('intro');
        intro.remove();
      };
      intro.addEventListener('transitionend', finish, { once: true });
      setTimeout(finish, 1200);
    };

    Promise.all([built, loaded]).then(leave);
    setTimeout(leave, 5500); // never wait long on a slow image
    // Any sign the visitor wants in skips straight to the wipe.
    for (const type of ['pointerdown', 'keydown', 'wheel', 'touchstart'] as const) {
      addEventListener(type, leave, { once: true, passive: true });
    }
  }
</script>

<style>
  .intro {
    display: none;
  }
  :global(html.intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 40% at 50% 46%, rgb(224 48 30 / 0.12), transparent 70%),
      var(--bg);
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.65s cubic-bezier(0.7, 0, 0.2, 1);
  }
  :global(html.intro) .intro.is-leaving {
    clip-path: inset(0 0 0 100%);
  }

  .lockup {
    display: grid;
    justify-items: center;
    gap: clamp(8px, 1.2vw, 12px);
    width: min(56vw, 300px);
  }
  .lockup :global(.logo) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* 1 · Headlight → road: the dashes start stacked in the middle as one red dot,
     then spread out to where each letter will stand. */
  .lockup :global(.dash) {
    transform-box: fill-box;
    transform-origin: center;
    animation:
      dash-in 0.8s 0.1s cubic-bezier(0.7, 0, 0.2, 1) both,
      dash-out 0.25s calc(0.95s + var(--i) * 70ms) ease-in forwards;
  }
  @keyframes dash-in {
    0% {
      transform: translateX(calc(var(--dx) * 1px)) scale(0);
    }
    30% {
      transform: translateX(calc(var(--dx) * 1px)) scale(0.55, 1.6);
    }
    100% {
      transform: translateX(0) scale(1);
    }
  }
  @keyframes dash-out {
    to {
      opacity: 0;
      transform: scale(0.3, 1);
    }
  }

  /* 2 · Road → name: each letter grows out of its dash. */
  .lockup :global(.letter) {
    transform-box: fill-box;
    transform-origin: center;
    animation: letter-in 0.6s calc(0.95s + var(--i) * 70ms) cubic-bezier(0.2, 0.9, 0.25, 1) both;
  }
  @keyframes letter-in {
    0% {
      opacity: 0;
      transform: scaleY(0.04);
    }
    15% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  /* 3 · The car is drawn like a brush stroke, belt line first. */
  .lockup :global(.stroke) {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    animation: draw 0.75s calc(1.3s + var(--o) * 0.17s) cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* 4 · Tagline settles in. */
  .tagline {
    font-family: 'Cinzel', 'Trajan Pro', Georgia, serif;
    font-size: clamp(0.56rem, 0.48rem + 0.4vw, 0.72rem);
    letter-spacing: 0.3em;
    margin-right: -0.3em; /* keep it optically centered despite the trailing letter-spacing */
    text-transform: uppercase;
    color: var(--text);
    animation: tagline-in 0.7s 2.05s cubic-bezier(0.2, 0.9, 0.25, 1) both;
  }
  @keyframes tagline-in {
    from {
      opacity: 0;
      letter-spacing: 0.75em;
    }
  }
</style>
