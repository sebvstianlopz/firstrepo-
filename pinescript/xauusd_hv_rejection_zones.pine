//@version=6
indicator("XAUUSD High-Volume Rejection Zones [1H]", shorttitle = "HV Zones", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ============================================================================
// XAUUSD HIGH-VOLUME REJECTION ZONES (built for the 1H chart)
//
// A zone is created when a candle has
//   - volume >= "Min volume" x the average of the previous N candles, AND
//   - a wick >= "Min wick" % of the candle range (price was rejected there).
// The zone is the wick (from the extreme to the body), sized between min / max ATR.
//   Lower wick -> DEMAND zone (green)      Upper wick -> SUPPLY zone (red)
//
// Lifetime
//   Fresh  : not yet retested (solid colour) - the backtested setup is the FIRST retest.
//   Tested : first retest finished (faded).
//   Broken : a candle closes "Break" x ATR through the far side -> zone deleted.
//            (Backtest: broken high-volume zones did worse than random when retested, so they are not flipped.)
//
// Backtest on OANDA:XAUUSD 1H (Nov 2025 - Sep 2026, 5000 bars), defaults:
//   First retest reaction (1 ATR bounce before a 0.3 ATR close through): 58.6% vs 52.3% for random zones.
//   Edge held in both halves of the data. Limit entry at the zone edge ~ break-even (+0.04R at 1R),
//   random zones -0.12R. Treat zones as higher-probability AREAS, not stand-alone entries.
//   The table on the chart re-runs this test live (real zones vs invisible random control zones).
// ============================================================================

// ---------------------------------------------------------------- Inputs
string G1 = "Zone detection"
int   volLen  = input.int(20, "Volume average length", minval = 5, group = G1)
float volK    = input.float(2.0, "Min volume (x average)", minval = 1.0, step = 0.1, group = G1, tooltip = "Backtest: 1.5x had no edge, 2.0x+ did. Higher = fewer, stronger zones.")
float wickMin = input.float(40, "Min wick (% of candle range)", minval = 10, maxval = 90, step = 5, group = G1)
float minW    = input.float(0.15, "Min zone width (ATR)", minval = 0.05, step = 0.05, group = G1)
float maxW    = input.float(0.6, "Max zone width (ATR)", minval = 0.1, step = 0.05, group = G1)

string G2 = "Zone lifetime"
int   ageDays    = input.int(15, "Max zone age (days)", minval = 1, group = G2)
float brkATR     = input.float(0.3, "Break = close beyond zone by (ATR)", minval = 0.0, step = 0.05, group = G2)
bool  showTested = input.bool(true, "Keep tested zones (faded)", group = G2)
int   maxZones   = input.int(60, "Max zones on chart", minval = 5, maxval = 150, group = G2)

string G3 = "Reaction backtest"
float reactATR = input.float(1.0, "Reaction size (ATR)", minval = 0.1, step = 0.1, group = G3)
int   lookBars = input.int(8, "Look-ahead bars", minval = 1, group = G3)
bool  showTbl  = input.bool(true, "Show stats table", group = G3)
string tblPos  = input.string("Top Right", "Table position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = G3)

string G4 = "Style"
color cDem     = input.color(color.new(#089981, 70), "Demand zone", group = G4, inline = "c")
color cSup     = input.color(color.new(#f23645, 70), "Supply zone", group = G4, inline = "c")
int   fadeT    = input.int(90, "Tested zone transparency", minval = 0, maxval = 100, group = G4)
bool  showLbl  = input.bool(true, "Show volume label in zone", group = G4)
bool  showMark = input.bool(true, "Mark the zone candle", group = G4)

// ---------------------------------------------------------------- Core series
float atrV = ta.atr(14)
float vAvg = ta.sma(volume, volLen)[1]
float vr   = not na(vAvg) and vAvg > 0 ? volume / vAvg : 0.0
float rng  = high - low
float upW  = high - math.max(open, close)
float dnW  = math.min(open, close) - low
bool  hv   = not na(atrV) and vr >= volK and rng > 0
bool  newSup = hv and upW >= wickMin / 100 * rng
bool  newDem = hv and dnW >= wickMin / 100 * rng
int   maxAge = math.max(10, int(ageDays * 86400 / timeframe.in_seconds()))
float prevClose = nz(close[1], close)

var bool volFeed = false
if volume > 0
    volFeed := true

// ---------------------------------------------------------------- Types & state
type HVZ
    float top
    float bot
    bool  supply
    float vr
    float zatr
    int   born
    bool  control = false
    int   state   = 0      // 0 fresh, 1 first retest in progress, 2 tested
    int   side    = 0      // which side of the zone price is on: 1 above, -1 below
    int   pdir    = 0
    int   pbar    = 0
    box   bx

var array<HVZ> zones = array.new<HVZ>()
var array<HVZ> ctrls = array.new<HVZ>()

// stats index: 0 = demand, 1 = supply
var array<int> nMade = array.new_int(2, 0)
var array<int> tR    = array.new_int(2, 0)
var array<int> rR    = array.new_int(2, 0)
var array<int> tC    = array.new_int(2, 0)
var array<int> rC    = array.new_int(2, 0)

// ---------------------------------------------------------------- Helpers
hash01(float x) =>
    float v = math.sin(x) * 43758.5453
    v - math.floor(v)

zoneColor(bool supply, bool faded) =>
    color c = supply ? cSup : cDem
    faded ? color.new(c, fadeT) : c

record(bool supply, bool isCtrl, int res) =>
    int k = supply ? 1 : 0
    if isCtrl
        tC.set(k, tC.get(k) + 1)
        rC.set(k, rC.get(k) + res)
    else
        tR.set(k, tR.get(k) + 1)
        rR.set(k, rR.get(k) + res)
    res

addZone(float top, float bot, bool supply) =>
    color c = zoneColor(supply, false)
    box b = box.new(left = time, top = top, right = time, bottom = bot, xloc = xloc.bar_time, extend = extend.right,
         border_color = color.new(c, math.max(0, color.t(c) - 50)), border_width = 1, bgcolor = c,
         text = showLbl ? str.tostring(vr, "#.0") + "x vol" : "", text_size = size.small,
         text_color = color.new(c, 0), text_halign = text.align_right, text_valign = text.align_center)
    int sd = prevClose > top ? 1 : prevClose < bot ? -1 : 0
    zones.push(HVZ.new(top, bot, supply, vr, atrV, bar_index, side = sd, bx = b))
    int k = supply ? 1 : 0
    nMade.set(k, nMade.get(k) + 1)
    // 3 invisible random control zones: same size, shifted 1-3 ATR up or down
    for j = 1 to 3
        float seed = bar_index * 12.9898 + j * 78.233 + top * 0.731
        float off  = (hash01(seed) < 0.5 ? -1.0 : 1.0) * (1.0 + 2.0 * hash01(seed * 1.618 + 3.7)) * atrV
        ctrls.push(HVZ.new(top + off, bot + off, supply, vr, atrV, bar_index, control = true))
    b

// Update every zone in the list. Returns +1 / -1 when a FRESH real zone is retested
// from above (support) / below (resistance) on this bar, else 0.
method update(array<HVZ> zs, bool isCtrl) =>
    int touchDir = 0
    int sz = zs.size()
    if sz > 0
        for i = sz - 1 to 0
            HVZ z = zs.get(i)
            bool kill = false
            if z.born < bar_index
                if z.side == 0
                    z.side := prevClose > z.top ? 1 : prevClose < z.bot ? -1 : 0
                if z.state == 1
                    float ra = z.zatr * reactATR
                    float ba = z.zatr * brkATR
                    int res = -1
                    if z.pdir == 1
                        res := close < z.bot - ba ? 0 : high >= z.top + ra ? 1 : -1
                    else
                        res := close > z.top + ba ? 0 : low <= z.bot - ra ? 1 : -1
                    if res == -1 and bar_index - z.pbar >= lookBars
                        res := 0
                    if res >= 0
                        record(z.supply, isCtrl, res)
                        z.state := 2
                        if isCtrl or not showTested
                            kill := true
                        if not isCtrl and showTested
                            color fc = zoneColor(z.supply, true)
                            z.bx.set_bgcolor(fc)
                            z.bx.set_border_color(color.new(fc, math.max(0, fadeT - 20)))
                            z.bx.set_text_color(color.new(fc, math.max(0, fadeT - 40)))
                else if z.state == 0 and z.side != 0
                    bool fromAbove = z.side == 1 and low <= z.top
                    bool fromBelow = z.side == -1 and high >= z.bot
                    if fromAbove or fromBelow
                        z.state := 1
                        z.pdir := fromAbove ? 1 : -1
                        z.pbar := bar_index
                        if not isCtrl
                            touchDir := z.pdir
                // broken: close through the far side
                float b2 = z.zatr * brkATR
                if (z.side == 1 and close < z.bot - b2) or (z.side == -1 and close > z.top + b2)
                    if z.state != 1
                        kill := true
                if close > z.top
                    z.side := 1
                else if close < z.bot
                    z.side := -1
                if bar_index - z.born > maxAge and z.state != 1
                    kill := true
            if kill
                if not isCtrl
                    z.bx.delete()
                zs.remove(i)
    touchDir

method cap(array<HVZ> zs, int maxN) =>
    int i = 0
    while zs.size() > maxN and i < zs.size()
        HVZ z = zs.get(i)
        if z.state == 1
            i += 1
        else
            if not z.control
                z.bx.delete()
            zs.remove(i)
            i += 0
    i

// ---------------------------------------------------------------- 1) Update existing zones
int freshTouch = zones.update(false)
int ctrlTouch  = ctrls.update(true)

// ---------------------------------------------------------------- 2) New zones
if newSup
    float top = high
    float w   = math.min(math.max(upW, minW * atrV), maxW * atrV)
    addZone(top, top - w, true)
if newDem
    float bot = low
    float w   = math.min(math.max(dnW, minW * atrV), maxW * atrV)
    addZone(bot + w, bot, false)

zones.cap(maxZones)
ctrls.cap(maxZones * 3)

// ---------------------------------------------------------------- 3) Plots & alerts
plotshape(showMark and newSup, "HV supply candle", shape.diamond, location.abovebar, color.new(#f23645, 0), size = size.tiny)
plotshape(showMark and newDem, "HV demand candle", shape.diamond, location.belowbar, color.new(#089981, 0), size = size.tiny)
alertcondition(newSup or newDem, "New high-volume zone", "XAUUSD: new high-volume rejection zone formed")
alertcondition(freshTouch == 1, "Fresh zone retest from above", "XAUUSD: price retesting a fresh high-volume zone from above (support)")
alertcondition(freshTouch == -1, "Fresh zone retest from below", "XAUUSD: price retesting a fresh high-volume zone from below (resistance)")

// ---------------------------------------------------------------- 4) Stats table
pct(int r, int t) => t > 0 ? 100.0 * r / t : na
fmt(float v) => na(v) ? "-" : str.tostring(v, "#.0") + "%"

var table tbl = table.new(tblPos == "Top Right" ? position.top_right : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Top Left" ? position.top_left : position.bottom_left, 6, 5, bgcolor = color.new(#131722, 10), border_color = color.new(#363a45, 0), border_width = 1, frame_color = color.new(#363a45, 0), frame_width = 1)

if barstate.isfirst
    tbl.merge_cells(0, 4, 5, 4)

if showTbl and barstate.islast
    color tx  = color.new(#d1d4dc, 0)
    color hbg = color.new(#2a2e39, 0)
    array<string> heads = array.from("Zone", "Made", "1st retests", "React %", "Random %", "Edge")
    for c = 0 to 5
        tbl.cell(c, 0, heads.get(c), text_color = tx, text_size = size.small, bgcolor = hbg)
    array<string> names = array.from("Demand", "Supply", "All")
    for row = 0 to 2
        int made = row == 2 ? nMade.get(0) + nMade.get(1) : nMade.get(row)
        int t    = row == 2 ? tR.get(0) + tR.get(1) : tR.get(row)
        int r    = row == 2 ? rR.get(0) + rR.get(1) : rR.get(row)
        int tc   = row == 2 ? tC.get(0) + tC.get(1) : tC.get(row)
        int rc   = row == 2 ? rC.get(0) + rC.get(1) : rC.get(row)
        float rp = pct(r, t)
        float cp = pct(rc, tc)
        float ed = na(rp) or na(cp) ? na : rp - cp
        color ec = na(ed) ? tx : ed >= 3 ? color.new(#00e676, 0) : ed <= -3 ? color.new(#ff5252, 0) : tx
        color nc = row == 0 ? color.new(cDem, 0) : row == 1 ? color.new(cSup, 0) : tx
        tbl.cell(0, row + 1, names.get(row), text_color = nc, text_size = size.small, text_halign = text.align_left)
        tbl.cell(1, row + 1, str.tostring(made), text_color = tx, text_size = size.small)
        tbl.cell(2, row + 1, str.tostring(t), text_color = tx, text_size = size.small)
        tbl.cell(3, row + 1, fmt(rp), text_color = tx, text_size = size.small)
        tbl.cell(4, row + 1, fmt(cp), text_color = tx, text_size = size.small)
        tbl.cell(5, row + 1, na(ed) ? "-" : (ed >= 0 ? "+" : "") + str.tostring(ed, "#.0"), text_color = ec, text_size = size.small)
    string note = not volFeed ? "No volume on this symbol - use OANDA:XAUUSD" : timeframe.in_seconds() != 3600 ? "Tuned for the 1H chart" : "1st retest: " + str.tostring(reactATR, "#.#") + " ATR bounce within " + str.tostring(lookBars) + " bars"
    tbl.cell(0, 4, note, text_color = color.new(#9598a1, 0), text_size = size.tiny, text_halign = text.align_left)
