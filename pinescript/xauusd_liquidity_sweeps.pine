//@version=6
indicator("XAUUSD Liquidity Sweeps", shorttitle = "Liq Sweep", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ============================================================================
// XAUUSD LIQUIDITY SWEEPS + MARKET STRUCTURE SHIFT  (v2: quality tiers + break-even)
//
// LIQUIDITY LEVELS (where stop orders sit)
//   Swing highs / lows (pivot), previous day high / low (PDH / PDL), previous week high / low
//   (PWH / PWL) and the Asia session high / low. Red = buy-side liquidity (above price),
//   green = sell-side liquidity (below price). A level is used once: it ends when price trades through it.
//
// SWEEP (x marker)
//   Price wicks through a level and the candle closes back on the other side
//   (or closes back within "Reclaim candles"). Sweeps deeper than "Max sweep depth" x ATR are ignored.
//
// SIGNAL = SWEEP + MARKET STRUCTURE SHIFT (MSS)
//   After a sweep of sell-side liquidity, BUY when a candle closes above the last minor swing high
//   (within "MSS window" candles). Mirror for SELL after a buy-side sweep.
//   Entry = MSS close. Stop = beyond the sweep extreme + 0.3 x ATR. Target = R:R x risk.
//   Break-even: once price reaches +1R the stop moves to entry (a stopped trade then counts as BE, not a loss).
//
// QUALITY TIERS (lowest failure rate first)
//   A+ = previous day / week high or low swept AND the MSS came within "Fast MSS" candles of the sweep
//   A  = previous day / week high or low swept, slower MSS
//   B  = swing or Asia level swept
//   "Minimum quality" controls which signals are drawn and alerted. All tiers are always tracked in the table.
//
// BACKTEST (Python, 0.30 $ spread, 2R target + break-even, rules and filters fixed before testing)
//   Failure = trade lost money.          Nov 2025 - Sep 2026          |  Oct 1-14 2026 (new data)
//   A+  OANDA 1H : 30 trades, 30% fail, +0.33R per trade             |  6 trades, 50% fail
//   A+  COMEX 1H : 34 trades, 35% fail, +0.27R per trade             |  5 trades, 60% fail
//   All OANDA 1H : 103 trades, 50% fail, +0.09R per trade            |  11 trades, 45% fail
//   Other filters tested and rejected: London/NY session only (MORE failures), 200 EMA trend (mixed),
//   sweep volume (helps only on 5m/15m), tight stops (too rare).
//   The low A+ failure rate did NOT hold in the first two weeks of October (small sample) - treat it as
//   a higher-quality setup, not a guarantee. Best tested on the 1H chart; 15m / 5m have less data.
// ============================================================================

// ---------------------------------------------------------------- Inputs
string G1 = "Liquidity levels"
bool   useSwing = input.bool(true, "Swing highs / lows", group = G1, inline = "sw")
int    pivLen   = input.int(5, "Pivot length", minval = 2, group = G1, inline = "sw")
bool   usePD    = input.bool(true, "Previous day high / low", group = G1)
bool   usePW    = input.bool(true, "Previous week high / low", group = G1)
bool   useAsia  = input.bool(true, "Asia session high / low", group = G1, inline = "as")
string asiaS    = input.session("0000-0700", "", group = G1, inline = "as", tooltip = "Session in UTC.")
float  maxAgeH  = input.float(240, "Level lifetime (hours)", minval = 1, group = G1)
int    maxLv    = input.int(60, "Max levels on chart", minval = 5, maxval = 150, group = G1)

string G2 = "Sweep & signal"
int    reclaimN = input.int(3, "Reclaim candles (0 = same candle only)", minval = 0, maxval = 10, group = G2)
float  maxDepth = input.float(1.5, "Max sweep depth (ATR)", minval = 0.1, step = 0.1, group = G2)
int    minorLen = input.int(2, "MSS swing length", minval = 1, group = G2)
int    mssBars  = input.int(12, "MSS window (candles after the sweep)", minval = 1, group = G2)
int    fastBars = input.int(6, "Fast MSS (candles) for A+", minval = 1, group = G2)
string minQ     = input.string("A+", "Minimum quality (signals & alerts)", options = ["A+", "A", "B"], group = G2, tooltip = "A+ = lowest historical failure rate, fewest signals. B = every signal.")
bool   allowL   = input.bool(true, "Longs", group = G2, inline = "d")
bool   allowS   = input.bool(true, "Shorts", group = G2, inline = "d")

string G4 = "Trade management"
float  rr       = input.float(2.0, "Target (R:R)", minval = 0.5, step = 0.5, group = G4)
bool   useBE    = input.bool(true, "Move stop to break-even at +1R", group = G4)
float  beAt     = input.float(1.0, "Break-even trigger (R)", minval = 0.25, step = 0.25, group = G4)
float  tradeHrs = input.float(16, "Max trade length (hours)", minval = 1, group = G4)
float  spreadIn = input.float(0.30, "Spread / cost per trade ($)", minval = 0, step = 0.05, group = G4)

string G3 = "Display"
bool   showLv   = input.bool(true, "Show liquidity levels", group = G3)
bool   showSw   = input.bool(true, "Show sweep markers", group = G3)
bool   showSig  = input.bool(true, "Show BUY / SELL signals", group = G3)
bool   showLvls = input.bool(true, "Draw entry / stop / target lines", group = G3)
bool   showTbl  = input.bool(true, "Show results table", group = G3)
string tblPos   = input.string("Top Right", "Table position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = G3)
color  cBuySide  = input.color(color.new(#f23645, 30), "Buy-side liquidity (highs)", group = G3)
color  cSellSide = input.color(color.new(#089981, 30), "Sell-side liquidity (lows)", group = G3)

// ---------------------------------------------------------------- Core
int   tfSec     = timeframe.in_seconds()
float barsPerHr = 3600.0 / tfSec
int   maxAge    = math.max(1, int(math.round(maxAgeH * barsPerHr)))
int   maxTrade  = math.max(1, int(math.round(tradeHrs * barsPerHr)))
float atrV      = ta.atr(14)
bool  confirmed = barstate.isconfirmed
bool  intraday  = timeframe.isintraday
int   minRank   = minQ == "A+" ? 2 : minQ == "A" ? 1 : 0

// minor swings for the MSS
float mph = ta.pivothigh(high, minorLen, minorLen)
float mpl = ta.pivotlow(low, minorLen, minorLen)
var float lastMPH = na
var float lastMPL = na
var int   lastMPHbar = na
var int   lastMPLbar = na
if not na(mph)
    lastMPH := mph
    lastMPHbar := bar_index - minorLen
if not na(mpl)
    lastMPL := mpl
    lastMPLbar := bar_index - minorLen

// major swings = liquidity
float sph = ta.pivothigh(high, pivLen, pivLen)
float spl = ta.pivotlow(low, pivLen, pivLen)

// previous day / week (closed candles only)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
bool newDay  = timeframe.change("D")
bool newWeek = timeframe.change("W")

// Asia session high / low (level created when the session ends)
bool inAsia = not na(time(timeframe.period, asiaS, "UTC"))
var float aHi = na
var float aLo = na
var int   aStart = na
float asiaDoneHi = na
float asiaDoneLo = na
int   asiaDoneBar = na
if inAsia
    if na(aHi)
        aStart := bar_index
    aHi := na(aHi) ? high : math.max(aHi, high)
    aLo := na(aLo) ? low : math.min(aLo, low)
else if not na(aHi)
    asiaDoneHi := aHi
    asiaDoneLo := aLo
    asiaDoneBar := aStart
    aHi := na
    aLo := na

// ---------------------------------------------------------------- Types & state
type Level
    float price
    bool  isHigh
    int   kind          // 0 swing, 1 PD, 2 PW, 3 Asia
    int   born
    int   state = 0     // 0 active, 1 breached (waiting for a close back inside)
    int   brkBar = 0
    float ext = na
    line  ln

type Sweep
    int   dir           // 1 = sell-side swept -> look for BUY, -1 = buy-side swept -> look for SELL
    float ext
    int   kind
    int   bar
    float mss           // structure level to break
    int   mssBar

type Trade
    int   dir
    int   rank          // 2 = A+, 1 = A, 0 = B
    bool  shown
    float entry
    float stop
    float tgt
    float risk
    int   bar
    bool  moved = false
    line  lE
    line  lS
    line  lT

var array<Level> levels = array.new<Level>()
var array<Sweep> sweeps = array.new<Sweep>()
var array<Trade> trades = array.new<Trade>()

// results per tier: index 0 = B, 1 = A, 2 = A+, 3 = shown (>= minimum quality)
var array<int>   rN  = array.new_int(4, 0)
var array<int>   rW  = array.new_int(4, 0)
var array<int>   rF  = array.new_int(4, 0)
var array<float> rS  = array.new_float(4, 0.0)
var float eq    = 0.0
var float peak  = 0.0
var float maxDD = 0.0

// ---------------------------------------------------------------- Helpers
kindName(int k) =>
    switch k
        0 => "Swing"
        1 => "PDH/PDL"
        2 => "PWH/PWL"
        => "Asia"

tierName(int r) =>
    r == 2 ? "A+" : r == 1 ? "A" : "B"

addLevel(float price, bool isHigh, int kind, int originBar) =>
    // only add if price is on the correct side (liquidity above highs / below lows)
    bool ok = isHigh ? close < price : close > price
    if ok
        line l = showLv ? line.new(originBar, price, bar_index, price, color = isHigh ? cBuySide : cSellSide,
             style = kind == 0 ? line.style_dotted : line.style_dashed, width = kind == 0 ? 1 : 2, extend = extend.right) : na
        levels.push(Level.new(price, isHigh, kind, bar_index, ln = l))
    ok

endLine(Level lv) =>
    if not na(lv.ln)
        lv.ln.set_extend(extend.none)
        lv.ln.set_x2(bar_index)
    lv.price

newTrade(int dir, float stop, int rank, int kind) =>
    float risk = math.abs(close - stop)
    if risk > 0
        float tgt   = close + dir * rr * risk
        bool  shown = rank >= minRank
        Trade t = Trade.new(dir, rank, shown, close, stop, tgt, risk, bar_index)
        if shown and showSig
            string txt = (dir == 1 ? "BUY " : "SELL ") + tierName(rank)
            label.new(bar_index, dir == 1 ? low : high, txt,
                 style = dir == 1 ? label.style_label_up : label.style_label_down, size = size.small,
                 color = dir == 1 ? color.new(#00c853, rank == 2 ? 0 : rank == 1 ? 25 : 50) : color.new(#d50000, rank == 2 ? 0 : rank == 1 ? 25 : 50), textcolor = color.white,
                 tooltip = "Liquidity sweep (" + kindName(kind) + ") + market structure shift, quality " + tierName(rank) + "\nEntry " + str.tostring(close, format.mintick) + "\nStop " + str.tostring(stop, format.mintick) + "\nTarget " + str.tostring(tgt, format.mintick) + (useBE ? "\nMove stop to entry at " + str.tostring(close + dir * beAt * risk, format.mintick) : ""))
            if showLvls
                t.lE := line.new(bar_index, close, bar_index + 1, close, color = color.new(#9598a1, 0))
                t.lS := line.new(bar_index, stop, bar_index + 1, stop, color = color.new(#ff5252, 0), style = line.style_dashed)
                t.lT := line.new(bar_index, tgt, bar_index + 1, tgt, color = color.new(#00e676, 0), style = line.style_dashed)
        if shown
            alert("XAUUSD " + (dir == 1 ? "BUY " : "SELL ") + tierName(rank) + " | liquidity sweep (" + kindName(kind) + ") + MSS" +
                 " | entry " + str.tostring(close, format.mintick) + " | stop " + str.tostring(stop, format.mintick) +
                 " | target " + str.tostring(tgt, format.mintick) + (useBE ? " | BE at " + str.tostring(close + dir * beAt * risk, format.mintick) : ""),
                 alert.freq_once_per_bar_close)
        trades.push(t)
    risk

record(int idx, float rn) =>
    rN.set(idx, rN.get(idx) + 1)
    rW.set(idx, rW.get(idx) + (rn > 0.05 ? 1 : 0))
    rF.set(idx, rF.get(idx) + (rn < -0.05 ? 1 : 0))
    rS.set(idx, rS.get(idx) + rn)
    rn

// ---------------------------------------------------------------- Run on closed candles
int buySig  = 0
int sellSig = 0
int buyBest = -1
int sellBest = -1
int sweepUp = 0
int sweepDn = 0
if confirmed and intraday
    // ---- 1) manage open trades (never on their entry candle): stop first, then target, then break-even move
    int nt = trades.size()
    if nt > 0
        for i = nt - 1 to 0
            Trade t = trades.get(i)
            if bar_index > t.bar
                float r = na
                if (t.dir == 1 and low <= t.stop) or (t.dir == -1 and high >= t.stop)
                    r := t.moved ? 0.0 : -1.0
                else if (t.dir == 1 and high >= t.tgt) or (t.dir == -1 and low <= t.tgt)
                    r := rr
                else if bar_index - t.bar >= maxTrade
                    r := t.dir * (close - t.entry) / t.risk
                else if useBE and not t.moved and ((t.dir == 1 and high >= t.entry + beAt * t.risk) or (t.dir == -1 and low <= t.entry - beAt * t.risk))
                    t.moved := true
                    t.stop  := t.entry
                    if not na(t.lS)
                        t.lS.set_y1(t.entry)
                        t.lS.set_y2(t.entry)
                        t.lS.set_color(color.new(#ffb74d, 0))
                if not na(t.lE)
                    t.lE.set_x2(bar_index)
                    t.lS.set_x2(bar_index)
                    t.lT.set_x2(bar_index)
                if not na(r)
                    float rn = r - spreadIn / t.risk
                    record(t.rank, rn)
                    if t.shown
                        record(3, rn)
                        eq += rn
                        peak := math.max(peak, eq)
                        maxDD := math.max(maxDD, peak - eq)
                    trades.remove(i)

    // ---- 2) sweeps of existing levels
    int nl = levels.size()
    if nl > 0
        for i = nl - 1 to 0
            Level lv = levels.get(i)
            bool kill = false
            if lv.born < bar_index
                int  swept = 0          // 1 = sell-side (low) swept, -1 = buy-side (high) swept
                float ext = na
                if lv.state == 0
                    if lv.isHigh and high > lv.price
                        if close < lv.price
                            swept := -1
                            ext := high
                        else if reclaimN > 0
                            lv.state := 1
                            lv.brkBar := bar_index
                            lv.ext := high
                        else
                            kill := true
                    else if not lv.isHigh and low < lv.price
                        if close > lv.price
                            swept := 1
                            ext := low
                        else if reclaimN > 0
                            lv.state := 1
                            lv.brkBar := bar_index
                            lv.ext := low
                        else
                            kill := true
                    else if bar_index - lv.born > maxAge
                        kill := true
                else
                    lv.ext := lv.isHigh ? math.max(lv.ext, high) : math.min(lv.ext, low)
                    if lv.isHigh and close < lv.price
                        swept := -1
                        ext := lv.ext
                    else if not lv.isHigh and close > lv.price
                        swept := 1
                        ext := lv.ext
                    else if bar_index - lv.brkBar >= reclaimN
                        kill := true
                if swept != 0
                    kill := true
                    float depth = swept == -1 ? ext - lv.price : lv.price - ext
                    if depth <= maxDepth * atrV
                        float mssLvl = swept == 1 ? lastMPH : lastMPL
                        int   mssBar = swept == 1 ? lastMPHbar : lastMPLbar
                        if not na(mssLvl)
                            sweeps.push(Sweep.new(swept, ext, lv.kind, bar_index, mssLvl, mssBar))
                        sweepUp += swept == -1 ? 1 : 0
                        sweepDn += swept == 1 ? 1 : 0
                        if showSw
                            label.new(bar_index, ext, "", style = label.style_xcross, size = size.tiny,
                                 color = swept == 1 ? color.new(#089981, 0) : color.new(#f23645, 0),
                                 tooltip = kindName(lv.kind) + (swept == 1 ? " low" : " high") + " swept")
            if kill
                endLine(lv)
                levels.remove(i)

    // ---- 3) sweep -> market structure shift -> signal (best tier wins when several fire on one candle)
    int   bestRankL = -1
    int   bestRankS = -1
    float stopL = na
    float stopS = na
    int   kindL = 0
    int   kindS = 0
    int   mssBarL = na
    int   mssBarS = na
    float mssL = na
    float mssS = na
    int ns = sweeps.size()
    if ns > 0
        for i = ns - 1 to 0
            Sweep sw = sweeps.get(i)
            bool done = false
            sw.ext := sw.dir == 1 ? math.min(sw.ext, low) : math.max(sw.ext, high)
            bool mss = sw.dir == 1 ? close > sw.mss : close < sw.mss
            if mss
                done := true
                bool gradeA = sw.kind == 1 or sw.kind == 2
                bool fast   = bar_index - sw.bar <= fastBars
                int  rank   = gradeA and fast ? 2 : gradeA ? 1 : 0
                float stp   = sw.dir == 1 ? sw.ext - 0.3 * atrV : sw.ext + 0.3 * atrV
                if sw.dir == 1 and allowL and rank > bestRankL
                    bestRankL := rank
                    stopL := stp
                    kindL := sw.kind
                    mssBarL := sw.mssBar
                    mssL := sw.mss
                if sw.dir == -1 and allowS and rank > bestRankS
                    bestRankS := rank
                    stopS := stp
                    kindS := sw.kind
                    mssBarS := sw.mssBar
                    mssS := sw.mss
            else if bar_index - sw.bar >= mssBars
                done := true
            if done
                sweeps.remove(i)
    if bestRankL >= 0
        newTrade(1, stopL, bestRankL, kindL)
        if bestRankL >= minRank
            buySig := 1
            buyBest := bestRankL
            if showLvls and showSig
                line.new(mssBarL, mssL, bar_index, mssL, color = color.new(#ffb74d, 0), style = line.style_dotted)
    if bestRankS >= 0
        newTrade(-1, stopS, bestRankS, kindS)
        if bestRankS >= minRank
            sellSig := 1
            sellBest := bestRankS
            if showLvls and showSig
                line.new(mssBarS, mssS, bar_index, mssS, color = color.new(#ffb74d, 0), style = line.style_dotted)

    // ---- 4) new liquidity levels (known at this close)
    if useSwing and not na(sph)
        addLevel(sph, true, 0, bar_index - pivLen)
    if useSwing and not na(spl)
        addLevel(spl, false, 0, bar_index - pivLen)
    if usePD and newDay and not na(pdh)
        addLevel(pdh, true, 1, bar_index)
        addLevel(pdl, false, 1, bar_index)
    if usePW and newWeek and not na(pwh)
        addLevel(pwh, true, 2, bar_index)
        addLevel(pwl, false, 2, bar_index)
    if useAsia and not na(asiaDoneHi)
        addLevel(asiaDoneHi, true, 3, asiaDoneBar)
        addLevel(asiaDoneLo, false, 3, asiaDoneBar)
    while levels.size() > maxLv
        Level old = levels.shift()
        endLine(old)

// ---------------------------------------------------------------- Alerts
// Simple alerts (fixed text). For alerts WITH entry / stop / target, create an alert on this indicator
// and choose "Any alert() function call".
alertcondition(buySig > 0, "BUY signal", "XAUUSD: BUY - liquidity sweep + market structure shift (quality >= your minimum)")
alertcondition(sellSig > 0, "SELL signal", "XAUUSD: SELL - liquidity sweep + market structure shift (quality >= your minimum)")
alertcondition(buyBest == 2 or sellBest == 2, "A+ signal", "XAUUSD: A+ liquidity sweep signal (PDH/PDL/PWH/PWL sweep + fast MSS)")
alertcondition(sweepDn > 0, "Sell-side liquidity swept", "XAUUSD: a low was swept (watch for a BUY structure shift)")
alertcondition(sweepUp > 0, "Buy-side liquidity swept", "XAUUSD: a high was swept (watch for a SELL structure shift)")

// ---------------------------------------------------------------- Results table
var table tbl = table.new(tblPos == "Top Right" ? position.top_right : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Top Left" ? position.top_left : position.bottom_left, 6, 7, bgcolor = color.new(#131722, 10), border_color = color.new(#363a45, 0), border_width = 1, frame_color = color.new(#363a45, 0), frame_width = 1)

if barstate.isfirst
    tbl.merge_cells(0, 6, 5, 6)

rStr(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "0.00") + "R"

if showTbl and barstate.islast
    color tx  = color.new(#d1d4dc, 0)
    color dim = color.new(#9598a1, 0)
    color hbg = color.new(#2a2e39, 0)
    array<string> heads = array.from("Quality", "Trades", "Fail %", "Win %", "Avg", "Total")
    for c = 0 to 5
        tbl.cell(c, 0, heads.get(c), text_color = tx, text_size = size.small, bgcolor = hbg)
    // rows: A+, A, B, shown
    array<int>    idxs  = array.from(2, 1, 0, 3)
    array<string> names = array.from("A+", "A", "B", "Shown (" + minQ + (minQ == "B" ? "" : "+") + ")")
    for row = 0 to 3
        int   k   = idxs.get(row)
        int   n   = rN.get(k)
        float avg = n > 0 ? rS.get(k) / n : na
        float fp  = n > 0 ? 100.0 * rF.get(k) / n : na
        color rc  = na(avg) ? tx : avg > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0)
        color fc  = na(fp) ? tx : fp <= 40 ? color.new(#00e676, 0) : fp >= 55 ? color.new(#ff5252, 0) : tx
        color bg  = row == 3 ? hbg : na
        tbl.cell(0, row + 1, names.get(row), text_color = row == 3 ? tx : dim, text_size = size.small, text_halign = text.align_left, bgcolor = bg)
        tbl.cell(1, row + 1, str.tostring(n), text_color = tx, text_size = size.small, bgcolor = bg)
        tbl.cell(2, row + 1, na(fp) ? "-" : str.tostring(fp, "0.0") + "%", text_color = fc, text_size = size.small, bgcolor = bg)
        tbl.cell(3, row + 1, n > 0 ? str.tostring(100.0 * rW.get(k) / n, "0.0") + "%" : "-", text_color = tx, text_size = size.small, bgcolor = bg)
        tbl.cell(4, row + 1, na(avg) ? "-" : rStr(avg), text_color = rc, text_size = size.small, bgcolor = bg)
        tbl.cell(5, row + 1, n > 0 ? rStr(rS.get(k)) : "-", text_color = rc, text_size = size.small, bgcolor = bg)
    tbl.cell(0, 5, "Max DD (shown)", text_color = dim, text_size = size.small, text_halign = text.align_left)
    tbl.cell(1, 5, str.tostring(maxDD, "0.0") + "R", text_color = tx, text_size = size.small)
    tbl.cell(2, 5, "Open", text_color = dim, text_size = size.small)
    tbl.cell(3, 5, str.tostring(trades.size()), text_color = tx, text_size = size.small)
    tbl.cell(4, 5, useBE ? "BE on" : "BE off", text_color = dim, text_size = size.small)
    tbl.cell(5, 5, "", text_color = tx, text_size = size.small)
    string note = not intraday ? "Use an intraday chart (1H recommended)" : "Fail = losing trade (BE exits are not failures). A+ = PDH/PDL/PWH/PWL sweep + MSS within " + str.tostring(fastBars) + " candles"
    tbl.cell(0, 6, note, text_color = dim, text_size = size.tiny, text_halign = text.align_left)
