//@version=6
indicator("XAUUSD HV Zones + Signals", shorttitle = "HVZ Sig", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ============================================================================
// XAUUSD HIGH-VOLUME ZONES + FAILED-BREAKOUT SIGNALS
//
// ZONES (from CLOSED 1H candles, no repainting)
//   A 1H candle with volume >= 2x its 20-bar average and a wick >= 40% of its range.
//   Zone = the wick.  Green = demand (lower wick), red = supply (upper wick).
//   Fresh = solid, touched = faded, swept (broken, waiting for a reclaim) = dashed grey.
//   Backtest (OANDA 1H, 10 months): price reacted on the first retest 58.6% of the time vs 52.3% for
//   random zones, and breakouts THROUGH these zones failed more often than breakouts through random levels.
//
// SIGNAL: FAILED BREAKOUT (sweep & reclaim)
//   1. Price closes through a zone by 0.3 x 1H ATR (the breakout).
//   2. Within "Reclaim window" hours it closes back on the original side of the zone -> the breakout failed.
//   BUY  = broke below a zone, then closed back above it.   SELL = broke above a zone, then closed back below it.
//   Entry = close of the reclaim candle.  Stop = beyond the extreme of the failed breakout + 0.3 x chart ATR.
//   Target = R:R x risk.  Time exit after "Max trade length".
//
// BACKTEST (Python, spread 0.30 $ included, 2R target, one signal per candle):
//   OANDA 1H 10 months : 64 trades, 50.0% win, -0.02R per trade (1st half -0.24R, 2nd half +0.20R)
//   COMEX 1H 10 months : 67 trades, 50.7% win, +0.12R per trade (1st half -0.03R, 2nd half +0.27R)
//   OANDA 15m 2.5 mo   : 13 trades, 61.5% win, +0.41R per trade (small sample)
//   Best of 5 signal ideas tested (~ +0.05R per trade on 1H), but NOT proven: it lost in the first
//   half of the 10 months on both feeds. The table tracks every signal on the history of YOUR chart.
//
// Best on the 1H or 15m chart (most tested). Works on any chart from 1m to 1H. Use OANDA:XAUUSD.
// ============================================================================

// ---------------------------------------------------------------- Inputs
string G1 = "Signals"
bool  showSig  = input.bool(true, "Show BUY / SELL signals", group = G1)
bool  allowL   = input.bool(true, "Longs", group = G1, inline = "d")
bool  allowS   = input.bool(true, "Shorts", group = G1, inline = "d")
float winHrs   = input.float(6, "Reclaim window (hours after the breakout)", minval = 0.5, step = 0.5, group = G1)
float rr       = input.float(2.0, "Target (R:R)", minval = 0.5, step = 0.5, group = G1)
float tradeHrs = input.float(16, "Max trade length (hours)", minval = 1, group = G1)
float spreadIn = input.float(0.30, "Spread / cost per trade ($)", minval = 0, step = 0.05, group = G1)
bool  showLvls = input.bool(true, "Draw entry / stop / target lines", group = G1)

string G2 = "1H zones"
float volK   = input.float(2.0, "Min volume (x 20-bar avg)", minval = 1.0, step = 0.1, group = G2)
float wickP  = input.float(40, "Min wick (% of range)", minval = 10, maxval = 90, step = 5, group = G2)
float minW   = input.float(0.15, "Min zone width (1H ATR)", minval = 0.05, step = 0.05, group = G2)
float maxW   = input.float(0.6, "Max zone width (1H ATR)", minval = 0.1, step = 0.05, group = G2)
float brkATR = input.float(0.3, "Breakout = close beyond zone by (1H ATR)", minval = 0.0, step = 0.05, group = G2)
int   ageD   = input.int(15, "Max zone age (days)", minval = 1, group = G2)
int   maxZ   = input.int(40, "Max zones", minval = 1, maxval = 150, group = G2)

string G3 = "Display"
bool  showZones = input.bool(true, "Draw zones", group = G3)
bool  showTbl   = input.bool(true, "Show results table", group = G3)
string tblPos   = input.string("Top Right", "Table position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = G3)
color cDem      = input.color(color.new(#089981, 70), "Demand zone", group = G3, inline = "c")
color cSup      = input.color(color.new(#f23645, 70), "Supply zone", group = G3, inline = "c")

// ---------------------------------------------------------------- Core
int   tfSec     = timeframe.in_seconds()
bool  tfOK      = tfSec <= 3600
float barsPerHr = 3600.0 / tfSec
int   winBars   = math.max(1, int(math.round(winHrs * barsPerHr)))
int   maxTrade  = math.max(1, int(math.round(tradeHrs * barsPerHr)))
int   maxAge    = int(math.round(ageD * 24 * barsPerHr))
float atrC      = ta.atr(14)
float prevClose = nz(close[1], close)
bool  confirmed = barstate.isconfirmed

var bool volFeed = false
if volume > 0
    volFeed := true

// ---- previous CLOSED 1H candle
htfCandle() =>
    float va  = ta.sma(volume, 20)[1]
    float r   = not na(va) and va > 0 ? volume / va : 0.0
    float rg  = high - low
    float uw  = high - math.max(open, close)
    float dw  = math.min(open, close) - low
    float a   = ta.atr(14)
    bool  ok  = not na(a) and r >= volK and rg > 0
    bool  sup = ok and uw >= wickP / 100 * rg
    bool  dem = ok and dw >= wickP / 100 * rg
    [sup[1], dem[1], high[1], low[1], uw[1], dw[1], a[1], r[1], time[1]]

[hSup, hDem, hH, hL, hUW, hDW, hATR, hVR, hT] = request.security(syminfo.tickerid, "60", htfCandle(), lookahead = barmerge.lookahead_on)
bool newHour = not na(hT) and hT != nz(hT[1])

// ---------------------------------------------------------------- Types & state
type Zone
    float top
    float bot
    bool  supply
    float zatr
    int   born
    int   side    = 0      // 1 price above the zone, -1 below
    int   state   = 0      // 0 active, 1 swept (waiting for reclaim)
    bool  touched = false
    int   rdir    = 0      // direction of the reclaim trade
    int   brkBar  = 0
    float ext     = na     // extreme of the failed breakout
    box   bx

type Trade
    int   dir
    float entry
    float stop
    float tgt
    float risk
    int   bar
    line  lE
    line  lS
    line  lT

var array<Zone>  zones  = array.new<Zone>()
var array<Trade> trades = array.new<Trade>()

// results
var int   nT   = 0
var int   nW   = 0
var float sumR = 0.0
var float peak = 0.0
var float maxDD = 0.0
var int   nL   = 0
var float sumRL = 0.0
var int   nS   = 0
var float sumRS = 0.0

// ---------------------------------------------------------------- Helpers
zoneColor(bool supply) =>
    supply ? cSup : cDem

styleZone(Zone z, int look) =>
    // look: 0 fresh, 1 touched, 2 swept
    if not na(z.bx)
        color c = zoneColor(z.supply)
        if look == 0
            z.bx.set_bgcolor(c)
            z.bx.set_border_color(color.new(c, 40))
        else if look == 1
            z.bx.set_bgcolor(color.new(c, 88))
            z.bx.set_border_color(color.new(c, 70))
        else
            z.bx.set_bgcolor(color.new(#787b86, 88))
            z.bx.set_border_color(color.new(#787b86, 30))
            z.bx.set_border_style(line.style_dashed)
    look

newTrade(int dir, float stop) =>
    float risk = math.abs(close - stop)
    if risk > 0
        float tgt = close + dir * rr * risk
        Trade t = Trade.new(dir, close, stop, tgt, risk, bar_index)
        if showSig
            label.new(bar_index, dir == 1 ? low : high, dir == 1 ? "BUY" : "SELL",
                 style = dir == 1 ? label.style_label_up : label.style_label_down, size = size.small,
                 color = dir == 1 ? color.new(#00c853, 0) : color.new(#d50000, 0), textcolor = color.white,
                 tooltip = "Failed breakout at a 1H high-volume zone\nEntry " + str.tostring(close, format.mintick) + "\nStop " + str.tostring(stop, format.mintick) + "\nTarget " + str.tostring(tgt, format.mintick))
            if showLvls
                t.lE := line.new(bar_index, close, bar_index + 1, close, color = color.new(#9598a1, 0), width = 1)
                t.lS := line.new(bar_index, stop, bar_index + 1, stop, color = color.new(#ff5252, 0), width = 1, style = line.style_dashed)
                t.lT := line.new(bar_index, tgt, bar_index + 1, tgt, color = color.new(#00e676, 0), width = 1, style = line.style_dashed)
        trades.push(t)
    risk

// Update zones on a closed bar. Returns [buy signals, sell signals] fired on this bar.
method step(array<Zone> zs) =>
    int buys  = 0
    int sells = 0
    int sz = zs.size()
    if sz > 0
        for i = sz - 1 to 0
            Zone z = zs.get(i)
            bool kill = false
            if z.born < bar_index
                if z.side == 0
                    z.side := prevClose > z.top ? 1 : prevClose < z.bot ? -1 : 0
                if z.state == 0
                    float bb = z.zatr * brkATR
                    if not z.touched and ((z.side == 1 and low <= z.top) or (z.side == -1 and high >= z.bot))
                        z.touched := true
                        styleZone(z, 1)
                    if z.side == 1 and close < z.bot - bb
                        z.state  := 1
                        z.rdir   := 1
                        z.brkBar := bar_index
                        z.ext    := low
                        styleZone(z, 2)
                    else if z.side == -1 and close > z.top + bb
                        z.state  := 1
                        z.rdir   := -1
                        z.brkBar := bar_index
                        z.ext    := high
                        styleZone(z, 2)
                    else
                        if close > z.top
                            z.side := 1
                        else if close < z.bot
                            z.side := -1
                        if bar_index - z.born > maxAge
                            kill := true
                else if bar_index > z.brkBar
                    z.ext := z.rdir == 1 ? math.min(z.ext, low) : math.max(z.ext, high)
                    bool reclaim = z.rdir == 1 ? close > z.top : close < z.bot
                    if reclaim
                        bool ok = z.rdir == 1 ? allowL and buys == 0 : allowS and sells == 0
                        if ok
                            newTrade(z.rdir, z.rdir == 1 ? z.ext - 0.3 * atrC : z.ext + 0.3 * atrC)
                            buys  += z.rdir == 1 ? 1 : 0
                            sells += z.rdir == -1 ? 1 : 0
                        kill := true
                    else if bar_index - z.brkBar >= winBars
                        kill := true
            if kill
                if not na(z.bx)
                    z.bx.delete()
                zs.remove(i)
    [buys, sells]

// ---------------------------------------------------------------- Run on closed bars
int buySig  = 0
int sellSig = 0
if confirmed and tfOK
    // close trades first (a trade never exits on its own entry candle)
    int sz = trades.size()
    if sz > 0
        for i = sz - 1 to 0
            Trade t = trades.get(i)
            if bar_index > t.bar
                float r = na
                if (t.dir == 1 and low <= t.stop) or (t.dir == -1 and high >= t.stop)
                    r := -1.0
                else if (t.dir == 1 and high >= t.tgt) or (t.dir == -1 and low <= t.tgt)
                    r := rr
                else if bar_index - t.bar >= maxTrade
                    r := t.dir * (close - t.entry) / t.risk
                if not na(t.lE)
                    t.lE.set_x2(bar_index)
                    t.lS.set_x2(bar_index)
                    t.lT.set_x2(bar_index)
                if not na(r)
                    float rn = r - spreadIn / t.risk
                    nT += 1
                    nW += rn > 0 ? 1 : 0
                    sumR += rn
                    peak := math.max(peak, sumR)
                    maxDD := math.max(maxDD, peak - sumR)
                    if t.dir == 1
                        nL += 1
                        sumRL += rn
                    else
                        nS += 1
                        sumRS += rn
                    trades.remove(i)
    [b, s] = zones.step()
    buySig  := b
    sellSig := s

// new zones from the previous closed 1H candle
if confirmed and tfOK and newHour and not na(hATR)
    if hSup
        float w = math.min(math.max(hUW, minW * hATR), maxW * hATR)
        box bx1 = showZones ? box.new(left = hT, top = hH, right = time, bottom = hH - w, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(cSup, 40), bgcolor = cSup, text = str.tostring(hVR, "#.0") + "x vol", text_size = size.tiny, text_color = color.new(cSup, 0), text_halign = text.align_right) : na
        zones.push(Zone.new(hH, hH - w, true, hATR, bar_index, side = prevClose > hH ? 1 : prevClose < hH - w ? -1 : 0, bx = bx1))
    if hDem
        float w = math.min(math.max(hDW, minW * hATR), maxW * hATR)
        box bx2 = showZones ? box.new(left = hT, top = hL + w, right = time, bottom = hL, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(cDem, 40), bgcolor = cDem, text = str.tostring(hVR, "#.0") + "x vol", text_size = size.tiny, text_color = color.new(cDem, 0), text_halign = text.align_right) : na
        zones.push(Zone.new(hL + w, hL, false, hATR, bar_index, side = prevClose > hL + w ? 1 : prevClose < hL ? -1 : 0, bx = bx2))
    while zones.size() > maxZ
        Zone old = zones.shift()
        if not na(old.bx)
            old.bx.delete()

// ---------------------------------------------------------------- Alerts
alertcondition(buySig > 0, "BUY signal", "XAUUSD: BUY - failed breakout below a 1H high-volume zone (reclaimed)")
alertcondition(sellSig > 0, "SELL signal", "XAUUSD: SELL - failed breakout above a 1H high-volume zone (reclaimed)")
alertcondition(buySig > 0 or sellSig > 0, "Any signal", "XAUUSD: failed-breakout signal at a 1H high-volume zone")

// ---------------------------------------------------------------- Results table
var table tbl = table.new(tblPos == "Top Right" ? position.top_right : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Top Left" ? position.top_left : position.bottom_left, 2, 9, bgcolor = color.new(#131722, 10), border_color = color.new(#363a45, 0), border_width = 1, frame_color = color.new(#363a45, 0), frame_width = 1)

if barstate.isfirst
    tbl.merge_cells(0, 0, 1, 0)
    tbl.merge_cells(0, 8, 1, 8)

rStr(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "0.00") + "R"

if showTbl and barstate.islast
    color tx  = color.new(#d1d4dc, 0)
    color dim = color.new(#9598a1, 0)
    float avg = nT > 0 ? sumR / nT : na
    color rc  = na(avg) ? tx : avg > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0)
    tbl.cell(0, 0, "Signal results on this chart", text_color = tx, text_size = size.small, bgcolor = color.new(#2a2e39, 0))
    tbl.cell(0, 1, "Trades", text_color = dim, text_size = size.small, text_halign = text.align_left)
    tbl.cell(1, 1, str.tostring(nT) + (trades.size() > 0 ? "  (+" + str.tostring(trades.size()) + " open)" : ""), text_color = tx, text_size = size.small)
    tbl.cell(0, 2, "Win rate", text_color = dim, text_size = size.small, text_halign = text.align_left)
    tbl.cell(1, 2, nT > 0 ? str.tostring(100.0 * nW / nT, "0.0") + "%" : "-", text_color = tx, text_size = size.small)
    tbl.cell(0, 3, "Avg per trade", text_color = dim, text_size = size.small, text_halign = text.align_left)
    tbl.cell(1, 3, na(avg) ? "-" : rStr(avg), text_color = rc, text_size = size.small)
    tbl.cell(0, 4, "Total", text_color = dim, text_size = size.small, text_halign = text.align_left)
    tbl.cell(1, 4, nT > 0 ? rStr(sumR) : "-", text_color = rc, text_size = size.small)
    tbl.cell(0, 5, "Max drawdown", text_color = dim, text_size = size.small, text_halign = text.align_left)
    tbl.cell(1, 5, nT > 0 ? str.tostring(maxDD, "0.0") + "R" : "-", text_color = tx, text_size = size.small)
    tbl.cell(0, 6, "Longs", text_color = dim, text_size = size.small, text_halign = text.align_left)
    tbl.cell(1, 6, str.tostring(nL) + "  " + (nL > 0 ? rStr(sumRL / nL) : "-"), text_color = tx, text_size = size.small)
    tbl.cell(0, 7, "Shorts", text_color = dim, text_size = size.small, text_halign = text.align_left)
    tbl.cell(1, 7, str.tostring(nS) + "  " + (nS > 0 ? rStr(sumRS / nS) : "-"), text_color = tx, text_size = size.small)
    string note = not tfOK ? "Use a chart of 1H or lower" : not volFeed ? "No volume on this symbol - use OANDA:XAUUSD" : "Break-even win rate at " + str.tostring(rr, "0.0") + "R: " + str.tostring(100.0 / (1 + rr), "0") + "% (before costs)"
    tbl.cell(0, 8, note, text_color = dim, text_size = size.tiny, text_halign = text.align_left)
